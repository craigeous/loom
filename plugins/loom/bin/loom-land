#!/usr/bin/env bash
# loom-land — remote-direct integration candidate construction and publication
# (ADR 0020). Builds a disposable candidate from the fetched remote target plus one
# slice head, gates it, and (publication mode) pushes it without force, verifies the
# remote independently, writes a receipt, then releases the claim.
#
# Usage (absolute path only):
#   loom-land --repo <path> --remote <name> --target-ref refs/heads/<b> \
#       --mode remote-direct --slice <id> --session <sid> --head <sha> \
#       [--gate <cmd>] [--finalize <cmd>] [--evidence <file>] [--candidate-only]
#
# --evidence is required for publication: loom-evidence/v1 JSON with schema,
# candidateSha, gate, gateEvidenceSha256, reviewEvidenceSha256 (hashes are opaque).
# --finalize runs in the candidate worktree after the merge (env LOOM_SLICE, LOOM_BASE,
#   LOOM_SLICE_HEAD) and is committed as one deterministic commit; it is required when the
#   slice plan at the slice head says 'Status: Ready to Publish'.
# State: <git-dir>/loom/session-<sid>/{candidate,candidate-manifest,publication-receipt}.json
# Exit codes: 0 verified success, 1 usage/input error, 3 contention, conflict,
#   retry exhaustion or target moved (fresh review evidence needed), 5 ownership
#   failure, 10 operational/unverifiable failure (owner action). Every nonzero
#   exit preserves the claim and recovery evidence.
# shellcheck disable=SC2016  # jq filters use $vars intentionally
set -euo pipefail

case "$0" in
/*) ;;
*)
    echo "loom-land: must be invoked by absolute path" >&2
    exit 1
    ;;
esac

COORD="${LOOM_COORD_BIN:-$(dirname "$0")/loom-coord}"
VERSION="loom-land/1"

log() { printf 'loom-land: %s\n' "$*" >&2; }
die() {
    local rc="$1"
    shift
    log "$*"
    exit "$rc"
}
safe_id() {
    case "$1" in
    '' | [!A-Za-z0-9]* | *[!A-Za-z0-9._-]* | *..*) return 1 ;;
    esac
}

REPO="" REMOTE="" TARGET_REF="" MODE="" SLICE="" SID="" HEAD_REV="" EVIDENCE=""
GATE="scripts/check" FINALIZE="" CAND_ONLY=0
while [ $# -gt 0 ]; do
    case "$1" in
    --candidate-only)
        CAND_ONLY=1
        shift
        continue
        ;;
    --repo | --remote | --target-ref | --mode | --slice | --session | --head | --gate | --finalize | --evidence)
        [ $# -ge 2 ] || die 1 "$1 requires a value"
        case "$1" in
        --repo) REPO="$2" ;;
        --remote) REMOTE="$2" ;;
        --target-ref) TARGET_REF="$2" ;;
        --mode) MODE="$2" ;;
        --slice) SLICE="$2" ;;
        --session) SID="$2" ;;
        --head) HEAD_REV="$2" ;;
        --gate) GATE="$2" ;;
        --finalize) FINALIZE="$2" ;;
        --evidence) EVIDENCE="$2" ;;
        esac
        shift 2
        ;;
    *) die 1 "unknown argument: $1 (see header for usage)" ;;
    esac
done

# --- readiness checks: all before any mutation -------------------------------
[ -n "$REPO" ] && [ -n "$REMOTE" ] && [ -n "$TARGET_REF" ] && [ -n "$SLICE" ] &&
    [ -n "$SID" ] && [ -n "$HEAD_REV" ] || die 1 "missing required argument (see header for usage)"
[ "$MODE" = "remote-direct" ] || die 1 "unsupported mode: '$MODE' (only remote-direct)"
case "$TARGET_REF" in refs/heads/?*) ;; *) die 1 "--target-ref must be a full refs/heads/ ref" ;; esac
git check-ref-format "$TARGET_REF" || die 1 "invalid --target-ref"
safe_id "$SLICE" || die 1 "invalid --slice"
safe_id "$SID" || die 1 "invalid --session"
[ -n "$GATE" ] || die 1 "--gate must be nonempty"
command -v jq >/dev/null 2>&1 || die 1 "jq is required"
REPO=$(git -C "$REPO" rev-parse --show-toplevel 2>/dev/null) || die 1 "--repo is not a git repository"
git -C "$REPO" remote get-url "$REMOTE" >/dev/null 2>&1 || die 1 "unknown remote: $REMOTE"
HEAD_SHA=$(git -C "$REPO" rev-parse --verify --quiet "$HEAD_REV^{commit}") || die 1 "--head is not a valid commit"

# A slice plan at the slice head (never the working tree or local main) makes the slice
# managed: it must be Ready to Publish and a finalizer must be supplied.
PLAN=".docs/slice-plans/$SLICE.md"
MANAGED=0
if PLAN_TXT=$(git -C "$REPO" show "$HEAD_SHA:$PLAN" 2>/dev/null); then
    MANAGED=1
    printf '%s\n' "$PLAN_TXT" | grep -q '^Status: Ready to Publish[[:space:]]*$' ||
        die 1 "$PLAN at $HEAD_SHA is not 'Status: Ready to Publish'"
    [ -n "$FINALIZE" ] || die 1 "managed slice $SLICE requires --finalize"
fi

EV_SHA="" EV_GH="" EV_RH=""
if [ "$CAND_ONLY" = 0 ]; then
    [ -n "$EVIDENCE" ] && [ -f "$EVIDENCE" ] || die 1 "publication requires --evidence <file>"
    jq -e --arg g "$GATE" '.schema == "loom-evidence/v1"
        and (.candidateSha | type == "string" and test("^[0-9a-f]{40}$"))
        and (.gate == $g)
        and (.gateEvidenceSha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and (.reviewEvidenceSha256 | type == "string" and test("^[0-9a-f]{64}$"))' \
        "$EVIDENCE" >/dev/null 2>&1 || die 1 "evidence is not valid loom-evidence/v1 for gate '$GATE'"
    EV_SHA=$(jq -r .candidateSha "$EVIDENCE")
    EV_GH=$(jq -r .gateEvidenceSha256 "$EVIDENCE")
    EV_RH=$(jq -r .reviewEvidenceSha256 "$EVIDENCE")
fi

GITDIR=$(git -C "$REPO" rev-parse --absolute-git-dir)
SDIR="$GITDIR/loom/session-$SID"
STATE="$SDIR/candidate.json"
RECEIPT="$SDIR/publication-receipt.json"
WT="$GITDIR/loom/land-$SID/wt"
BR="loom-land/$SID-$SLICE"
CAND_REF="refs/loom/land/$SID/candidate"
TGT_REF="refs/loom/land/$SID/target"
LOCKED=0 CAND="" BASE="" INIT_BASE="" CLAIM=0 TIP=""
# Fetch, recovery and verification all inspect the exact push destination.
PUSH_DEST=$(git -C "$REPO" config --get "remote.$REMOTE.pushurl" 2>/dev/null || git -C "$REPO" config --get "remote.$REMOTE.url" 2>/dev/null || printf '%s' "$REMOTE")

coord() { (cd "$REPO" && "$COORD" "$@"); }

# receipt_matches <jq expr> <expected> — the existing receipt binds the expected values
receipt_matches() { [ -f "$RECEIPT" ] && [ "$(jq -r "$1" "$RECEIPT" 2>/dev/null || true)" = "$2" ]; }

claims=$(coord list-claims) || die 10 "cannot list claims"
if printf '%s\n' "$claims" | awk -F'\t' -v s="$SLICE" -v c="$SID" '$1 == s && $2 == c { f = 1 } END { exit !f }'; then
    CLAIM=1
elif [ "$CAND_ONLY" = 1 ] || ! receipt_matches '[.slice,.session] | join("|")' "$SLICE|$SID"; then
    die 5 "session $SID does not hold the claim for $SLICE"
fi

cleanup_wt() {
    git -C "$REPO" worktree remove --force "$WT" >/dev/null 2>&1 || true
    rm -rf "$WT"
    git -C "$REPO" worktree prune >/dev/null 2>&1 || true
    git -C "$REPO" branch -D "$BR" >/dev/null 2>&1 || true
}
release_lock() {
    if [ "$LOCKED" = 1 ]; then
        coord lock-release --session "$SID" >/dev/null 2>&1 || true
        LOCKED=0
    fi
}
trap 'rc=$?; trap - EXIT; release_lock; cleanup_wt; exit $rc' EXIT

# lock_ok [rc] — require a still-held publish lock before a protected mutation
lock_ok() { coord lock-verify --session "$SID" >/dev/null 2>&1 || die "${1:-5}" "publish lock lost or not held"; }
acquire_lock() {
    local rc=0
    [ "$LOCKED" = 1 ] && return 0
    coord lock-acquire --session "$SID" >/dev/null 2>&1 || rc=$?
    case "$rc" in
    0) LOCKED=1 ;;
    3) die 3 "publish lock busy (retries exhausted)" ;;
    *) die 10 "cannot acquire publish lock" ;;
    esac
}
atomic_jq() { # atomic_jq <dest> <jq args...> <filter>
    local dest="$1" tmp
    shift
    tmp="$dest.tmp.$$"
    if ! { jq -n "$@" >"$tmp" && mv "$tmp" "$dest"; }; then
        rm -f "$tmp"
        die 10 "cannot write $dest"
    fi
}
set_attempt() { # set_attempt true|false — record whether a publication attempt is outstanding
    local tmp="$STATE.tmp.$$"
    if ! { jq --argjson a "$1" '.publishAttempt = $a' "$STATE" >"$tmp" && mv "$tmp" "$STATE"; }; then
        rm -f "$tmp"
        die 10 "cannot update $STATE"
    fi
}
# receipt_valid — the existing receipt binds every publication input of this run
receipt_valid() {
    [ -f "$RECEIPT" ] && jq -e --arg sl "$SLICE" --arg se "$SID" --arg re "$REMOTE" --arg tr "$TARGET_REF" \
        --arg mo "$MODE" --arg ca "$CAND" --arg sh "$HEAD_SHA" --arg gh "$EV_GH" --arg rh "$EV_RH" \
        '.schema == "loom-receipt/v1" and .slice == $sl and .session == $se and .remote == $re
         and .targetRef == $tr and .mode == $mo and .candidateSha == $ca and .sliceHead == $sh
         and .gateEvidenceSha256 == $gh and .reviewEvidenceSha256 == $rh' "$RECEIPT" >/dev/null 2>&1
}
state_get() { [ -f "$STATE" ] && jq -r "($1) // empty" "$STATE" 2>/dev/null || true; }

fetch_target() {
    git -C "$REPO" fetch --quiet --no-tags "$PUSH_DEST" "+$TARGET_REF:$TGT_REF" >&2 || die 10 "cannot fetch $REMOTE $TARGET_REF"
    BASE=$(git -C "$REPO" rev-parse --verify --quiet "$TGT_REF^{commit}") || die 10 "cannot resolve fetched target"
}

write_state() {
    mkdir -p "$SDIR" 2>/dev/null || die 10 "cannot create session directory"
    atomic_jq "$STATE" --arg sl "$SLICE" --arg se "$SID" --arg re "$REMOTE" --arg tr "$TARGET_REF" \
        --arg mo "$MODE" --arg sh "$HEAD_SHA" --arg ba "$BASE" --arg ca "$CAND" --arg ga "$GATE" \
        --arg fz "$FINALIZE" --arg gh "$EV_GH" --arg rh "$EV_RH" \
        '{schema: "loom-candidate/v1", slice: $sl, session: $se, remote: $re, targetRef: $tr, mode: $mo,
          sliceHead: $sh, baseCommit: $ba, candidateSha: $ca, gate: $ga, finalize: $fz,
          gateEvidenceSha256: $gh, reviewEvidenceSha256: $rh}'
}

# deterministic_identity — merge and finalization commits take identity and dates from the
# slice head, so identical inputs yield an identical candidate SHA on any host at any time.
deterministic_identity() {
    local v
    v=$(git -C "$REPO" log -1 --date=raw --format='%an|%ae|%ad|%cn|%ce|%cd' "$HEAD_SHA") ||
        die 10 "cannot read slice head identity"
    IFS='|' read -r GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE <<<"$v"
    export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE
}

# finalize_candidate — run the caller's finalizer in the candidate worktree, commit its
# output as one commit, and (managed slice) verify the finalization artifact set.
finalize_candidate() {
    local p
    if [ -n "$FINALIZE" ]; then
        (cd "$WT" && LOOM_SLICE="$SLICE" LOOM_BASE="$BASE" LOOM_SLICE_HEAD="$HEAD_SHA" bash -c "$FINALIZE") >&2 ||
            die 10 "finalize failed (state, claim and remote untouched)"
        if [ -n "$(git -C "$WT" status --porcelain)" ]; then
            { git -C "$WT" add -A && git -C "$WT" commit -q -m "Finalize slice $SLICE"; } >&2 ||
                die 10 "cannot commit finalization"
        fi
    fi
    [ "$MANAGED" = 1 ] || return 0
    [ ! -e "$WT/$PLAN" ] || die 1 "finalization incomplete: $PLAN still present"
    [ -f "$WT/.docs/slice-plans/archive/$SLICE.md" ] || die 1 "finalization incomplete: archive/$SLICE.md missing"
    for p in .docs/slice-plans/README.md .docs/status/progress.md .docs/status/handoff.md .docs/status/roadmap.md; do
        if git -C "$WT" diff --quiet "$BASE" HEAD -- "$p" 2>/dev/null; then
            die 1 "finalization incomplete: $p unchanged from base"
        fi
    done
    return 0
}

# build — construct (or reuse) the candidate on $BASE in a disposable worktree,
# gate it, and record candidate state. Sets CAND.
build() {
    local prev
    cleanup_wt
    prev=$(state_get .candidateSha)
    mkdir -p "$(dirname "$WT")" || die 10 "cannot create candidate worktree directory"
    deterministic_identity
    if [ -n "$prev" ] && [ "$(git -C "$REPO" rev-parse --verify --quiet "$CAND_REF" || true)" = "$prev" ] &&
        [ "$(state_get '[.slice,.session,.remote,.targetRef,.mode,.sliceHead,.baseCommit,.finalize] | join("|")')" = "$SLICE|$SID|$REMOTE|$TARGET_REF|$MODE|$HEAD_SHA|$BASE|$FINALIZE" ]; then
        git -C "$REPO" worktree add -q -b "$BR" "$WT" "$prev" >&2 || die 10 "cannot create candidate worktree"
    else
        git -C "$REPO" worktree add -q -b "$BR" "$WT" "$BASE" >&2 || die 10 "cannot create candidate worktree"
        if ! git -C "$WT" merge -q --no-ff -m "Integrate slice $SLICE" "$HEAD_SHA" >&2; then
            git -C "$WT" merge --abort >/dev/null 2>&1 || true
            die 3 "merge conflict integrating $HEAD_SHA onto $BASE"
        fi
        finalize_candidate
    fi
    CAND=$(git -C "$WT" rev-parse HEAD) || die 10 "cannot resolve candidate"
    git -C "$REPO" update-ref "$CAND_REF" "$CAND" || die 10 "cannot record candidate ref"
    write_state
    # The manifest is untracked recovery state: it never enters the candidate tree.
    atomic_jq "$SDIR/candidate-manifest.json" --arg sl "$SLICE" --arg se "$SID" --arg re "$REMOTE" \
        --arg tr "$TARGET_REF" --arg mo "$MODE" --arg sh "$HEAD_SHA" --arg ba "$BASE" \
        '{slice: $sl, session: $se, remote: $re, targetRef: $tr, mode: $mo, sliceHead: $sh, baseCommit: $ba}'
    (cd "$WT" && bash -c "$GATE") >&2 || die 10 "gate failed for candidate $CAND (state preserved)"
    [ -z "$(git -C "$WT" status --porcelain)" ] && [ "$(git -C "$WT" rev-parse HEAD)" = "$CAND" ] ||
        die 10 "candidate $CAND was dirtied or changed by the gate"
}

write_receipt() { # write_receipt <push outcome> <verification outcome> <result sha>
    atomic_jq "$RECEIPT" --arg sl "$SLICE" --arg se "$SID" --arg re "$REMOTE" --arg tr "$TARGET_REF" \
        --arg mo "$MODE" --arg sh "$HEAD_SHA" --arg ib "$INIT_BASE" --arg fb "$BASE" --arg ca "$CAND" \
        --arg rs "$3" --arg ga "$GATE" --arg gh "$EV_GH" --arg rh "$EV_RH" --arg v "$VERSION" \
        --arg po "$1" --arg vo "$2" \
        '{schema: "loom-receipt/v1", helper: $v, slice: $sl, session: $se, remote: $re, targetRef: $tr,
          mode: $mo, sliceHead: $sh, initialBase: $ib, finalBase: $fb, candidateSha: $ca, resultSha: $rs,
          gate: $ga, gateEvidenceSha256: $gh, reviewEvidenceSha256: $rh, push: $po, verification: $vo}'
}

# finish — after the receipt exists: release claim and lock, clean up, update mirror.
finish() {
    if [ "$CLAIM" = 1 ]; then
        acquire_lock
        lock_ok 10
        coord release-claim "$SLICE" --session "$SID" >/dev/null 2>&1 || die 10 "published and receipted, but release-claim failed"
    fi
    release_lock
    cleanup_wt
    git -C "$REPO" update-ref -d "$CAND_REF" || true
    [ ! -f "$STATE" ] || set_attempt false
    if [ "$(git -C "$REPO" symbolic-ref -q HEAD || true)" = "$TARGET_REF" ] &&
        [ -z "$(git -C "$REPO" status --porcelain)" ]; then
        git -C "$REPO" merge -q --ff-only "$CAND" >/dev/null 2>&1 || log "local mirror not fast-forwarded (ignored)"
    fi
    printf 'landed %s\n' "$CAND"
    exit 0
}

# --- main ----------------------------------------------------------------
mkdir -p "$SDIR" 2>/dev/null || die 10 "cannot create session directory"
fetch_target
INIT_BASE="$BASE"
PREV_CAND=$(state_get .candidateSha)

# Recovery: a recorded candidate for these inputs is already contained in the remote target.
if [ "$CAND_ONLY" = 0 ] && [ -n "$PREV_CAND" ] && [ "$PREV_CAND" = "$EV_SHA" ] &&
    [ "$(state_get '[.slice,.session,.remote,.targetRef,.sliceHead] | join("|")')" = "$SLICE|$SID|$REMOTE|$TARGET_REF|$HEAD_SHA" ] &&
    git -C "$REPO" merge-base --is-ancestor "$PREV_CAND" "$TGT_REF" 2>/dev/null; then
    log "candidate $PREV_CAND already contained in $REMOTE $TARGET_REF; completing without republishing"
    CAND="$PREV_CAND"
    if ! receipt_valid; then
        [ "$CLAIM" = 1 ] || die 5 "no receipt for $SLICE candidate $CAND and session $SID does not hold the claim"
        acquire_lock
        lock_ok 10
        fetch_target # refresh remote truth under the lock; the receipt records the observed target
        git -C "$REPO" merge-base --is-ancestor "$CAND" "$TGT_REF" 2>/dev/null ||
            die 10 "candidate $CAND no longer contained in $REMOTE $TARGET_REF; owner action required"
        TIP="$BASE"
        BASE=$(state_get .baseCommit)
        INIT_BASE="$BASE"
        write_receipt recovered contained "$TIP"
        lock_ok 10
    fi
    finish
fi
# An earlier publication attempt whose outcome is unknown must not be overwritten.
if [ -n "$PREV_CAND" ] && [ "$(state_get .publishAttempt)" = true ]; then
    die 10 "prior publication of $PREV_CAND is unresolved and not contained in $REMOTE $TARGET_REF; owner action required (state preserved)"
fi
[ "$CLAIM" = 1 ] || die 5 "session $SID does not hold the claim for $SLICE"

build
if [ "$CAND_ONLY" = 1 ]; then
    cleanup_wt
    printf '%s\n' "$CAND"
    exit 0
fi
if [ "$CAND" != "$EV_SHA" ]; then
    if [ "$PREV_CAND" = "$EV_SHA" ]; then
        die 3 "contention: target moved, candidate rebuilt at $CAND; fresh review evidence bound to $CAND is required before publication"
    fi
    die 1 "evidence candidateSha $EV_SHA does not match candidate $CAND"
fi

acquire_lock
fetch_target
if [ "$BASE" != "$(state_get .baseCommit)" ]; then
    # The target moved while building: leave the lock, then rebuild and gate unlocked.
    release_lock
    build
    die 3 "contention: target moved, candidate rebuilt at $CAND; fresh review evidence bound to $CAND is required before publication"
fi
lock_ok
set_attempt true
PUSH=pushed
git -C "$REPO" push --quiet "$PUSH_DEST" "$CAND:$TARGET_REF" >&2 || PUSH=rejected
LS_OK=1
REMOTE_SHA=$(git -C "$REPO" ls-remote "$PUSH_DEST" "$TARGET_REF" | awk 'NR == 1 { print $1 }') || LS_OK=0
if [ "$REMOTE_SHA" != "$CAND" ]; then
    # ancestry A B -> 0 A is an ancestor of B, 1 it is not, 2 unknown (missing objects or git error)
    ancestry() {
        local rc=0
        git -C "$REPO" merge-base --is-ancestor "$1" "$2" >/dev/null 2>&1 || rc=$?
        case "$rc" in 0 | 1) return "$rc" ;; *) return 2 ;; esac
    }
    FETCHED=""
    if [ "$LS_OK" = 1 ] && [ -n "$REMOTE_SHA" ] &&
        git -C "$REPO" fetch --quiet --no-tags "$PUSH_DEST" "+$TARGET_REF:$TGT_REF" >&2 2>/dev/null; then
        FETCHED=$(git -C "$REPO" rev-parse --verify --quiet "$TGT_REF^{commit}" || true)
    fi
    if [ -n "$FETCHED" ] && [ "$FETCHED" = "$REMOTE_SHA" ]; then
        rc=0
        ancestry "$CAND" "$REMOTE_SHA" || rc=$?
        if [ "$rc" = 0 ]; then
            # The server accepted the candidate and another publisher then advanced: containment.
            write_receipt "$PUSH" contained "$REMOTE_SHA"
            lock_ok 10
            finish
        fi
        if [ "$PUSH" = rejected ] && [ "$rc" = 1 ]; then
            rc_in=0 rc_base=0
            ancestry "$REMOTE_SHA" "$CAND" || rc_in=$?
            ancestry "$BASE" "$REMOTE_SHA" || rc_base=$?
            if [ "$rc_in" = 1 ] && [ "$rc_base" = 0 ]; then
                set_attempt false
                die 3 "push rejected: target moved to $REMOTE_SHA; will rebuild next run (fresh review evidence needed)"
            fi
        fi
    fi
    die 10 "push $PUSH but remote target ${REMOTE_SHA:-unreadable} != candidate $CAND; unverified (publication attempt preserved, owner action required)"
fi
write_receipt "$PUSH" verified "$REMOTE_SHA"
lock_ok 10
finish

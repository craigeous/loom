#!/usr/bin/env bash
# loom-launch-role — the sole client role launcher (spec 10 -> Versioned
# compatibility and capability mapping; ADR 0018/0019; the v0.2.0 live proof
# (ADR 0032 E4).
#
# Usage:
#   loom-launch-role claude|codex researcher|planner|plan-evaluator|developer|code-evaluator
#
# The caller supplies only a client and a role. Every model/tier/effort value is
# derived from the tracked, versioned compatibility matrix
# (adapters/compatibility/v0.3.0.json) resolved relative to this script's own
# physical location -- never from a caller-supplied vendor selector, a bare
# PATH lookup, CLAUDE_PLUGIN_ROOT, PLUGIN_ROOT, or CODEX_HOME.
#
# Model/effort resolution (ADR 0027 section 2), highest precedence first:
#   1. --model <id> / --effort low|medium|high flags
#   2. .docs/loom-models.json (project root; {"<client>":{"model","effort"}})
#   3. ambient client config (codex: ~/.codex/config.toml `model`;
#      antigravity: `agy models`, cached 24h; claude: floating tier selector)
#   4. the compatibility matrix floor
# Every explicit/repo/ambient value is validated and fails closed (exit 2).
#
# Claude launches never spawn a process: this prints one line of normalized
# effective launch configuration (schema loom-role-launch/v1) to stdout after
# cross-checking the installed native tier + tool allowlist in
# agents/<role>.md against the matrix (the exact native tier; the Agent
# delegation capability is proven omitted, never granted at runtime).
#
# Codex launches print that same normalized configuration line and then
# execute a fresh, ephemeral `codex exec` child (read-only sandbox, no web
# search, delegation disabled, a closed bounded-output schema) via
# `exec env LOOM_LAUNCH_ROLE_ACTIVE=1 "$CODEX_BIN" ...`. Tests MUST NOT spawn a
# live codex process: point LOOM_LAUNCH_ROLE_CODEX_BIN at a stub executable
# that records its argv/environment and this script will invoke that stub
# instead, exercising the real argument-construction path.
#
# Exact `codex exec` sandbox/web-search flag spelling is this slice's best
# engineering judgment; the one real cold launch per client in
# the v0.2.0 live proof (ADR 0032 E4) is authoritative and may require reconciliation.
#
# FAIL DIRECTION: fail-closed. Exit codes:
#   0 — success
#   1 — usage error (bad argument shape)
#   2 — fail-closed: a resolution/identity/policy check failed
set -u

ROLES=(researcher planner plan-evaluator developer code-evaluator)
CLIENTS=(claude codex antigravity)
VENDOR_OVERRIDE_VARS=(CODEX_MODEL MODEL_REASONING_EFFORT OPENAI_MODEL ANTHROPIC_MODEL CLAUDE_MODEL LOOM_LAUNCH_ROLE_MODEL LOOM_LAUNCH_ROLE_EFFORT LOOM_LAUNCH_ROLE_SELECTOR)

_usage() {
    printf 'usage: loom-launch-role claude|codex|antigravity|auto researcher|planner|plan-evaluator|developer|code-evaluator [--author-client claude|codex|antigravity] [--routing-file /abs/path] [--model id] [--effort low|medium|high]\n' >&2
    exit 1
}

_fail() {
    printf 'loom-launch-role: %s\n' "$1" >&2
    exit 2
}

_is_member() {
    local needle="$1" straw
    shift
    for straw in "$@"; do
        [ "$straw" = "$needle" ] && return 0
    done
    return 1
}

# _canon_dir <path> — canonicalize an existing directory to its absolute
# physical path (symlinks in the directory chain resolved by cd -P).
_canon_dir() {
    CDPATH='' cd -- "$1" 2>/dev/null && pwd -P
}

# _frontmatter_field <file> <key> — print the first top-level "key: value"
# frontmatter line's trimmed value; fails if the file has no frontmatter or
# the key is absent before the closing "---".
_frontmatter_field() {
    local file="$1" key="$2" in_fm=0 line prefix
    prefix="$key: "
    while IFS= read -r line || [ -n "$line" ]; do
        if [ "$in_fm" -eq 0 ]; then
            if [ "$line" = "---" ]; then
                in_fm=1
                continue
            fi
            return 1
        fi
        [ "$line" = "---" ] && return 1
        case "$line" in
        "$prefix"*)
            printf '%s\n' "${line#"$prefix"}"
            return 0
            ;;
        esac
    done <"$file"
    return 1
}

# _csv_contains <csv> <item> — true if item is a comma-separated member,
# trimming a single leading space around each element (matches "A, B, C").
_csv_contains() {
    local csv="$1" item="$2" IFS=',' token
    for token in $csv; do
        token="${token# }"
        [ "$token" = "$item" ] && return 0
    done
    return 1
}

# _cold_id — a fresh, unique launch identifier; never caller-supplied,
# never reused across invocations.
_cold_id() {
    local tmp base
    tmp=$(mktemp -u "${TMPDIR:-/tmp}/loom-launch-role.XXXXXXXXXXXXXXXX" 2>/dev/null) || return 1
    base=$(basename -- "$tmp")
    case "$base" in
    loom-launch-role.?*) printf '%s\n' "${base#loom-launch-role.}" ;;
    *) return 1 ;;
    esac
}

# _role_key <role> — the compatibility matrix's human "consumers" spelling.
_role_key() {
    case "$1" in
    plan-evaluator) printf 'plan evaluator' ;;
    code-evaluator) printf 'code evaluator' ;;
    *) printf '%s' "$1" ;;
    esac
}

# _json_escape <value> — minimal JSON string escaping for our own
# already-enumerated/validated values (no control characters expected).
_json_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    printf '%s' "$value"
}

# _json_argv_array <arg...> — render a bash argv array as a JSON string array.
_json_argv_array() {
    local out="[" first=1 arg
    for arg in "$@"; do
        [ "$first" -eq 1 ] || out="$out,"
        first=0
        out="$out\"$(_json_escape "$arg")\""
    done
    printf '%s]' "$out"
}

_guard_descendant() {
    [ -z "${LOOM_LAUNCH_ROLE_ACTIVE:-}" ] || _fail "descendant launch attempt rejected: role delegation is forbidden"
}

_guard_vendor_override() {
    local var value
    for var in "${VENDOR_OVERRIDE_VARS[@]}"; do
        value="${!var:-}"
        [ -z "$value" ] || _fail "environment attempts to override vendor model/effort selection: $var is set"
    done
}

_guard_delegation_env() {
    case "${LOOM_LAUNCH_ROLE_ALLOW_DELEGATION:-}" in
    "" | 0 | false | no) ;;
    *) _fail "delegation feature enabled: LOOM_LAUNCH_ROLE_ALLOW_DELEGATION is set" ;;
    esac
}

_matrix_field() {
    # _matrix_field <matrix-json> <profile> <jq-path-after-.codex-or-.claude>
    printf '%s' "$1" | jq -r --arg p "$2" "[.profiles[] | select(.profile==\$p)] | .[0]$3 // empty"
}

_sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        shasum -a 256 "$1" | awk '{print $1}'
    fi
}

_next_client_in_cycle() {
    case "$1" in
    claude) printf 'codex' ;;
    codex) printf 'antigravity' ;;
    antigravity) printf 'claude' ;;
    *) return 1 ;;
    esac
}

CODEX_MODEL_RE='^(gpt-6(\.[0-9]+)?(-[a-z0-9]+)?|gpt-5\.6(-[a-z0-9]+)?)$'
AGY_MODEL_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'
AGY_CACHE_TTL=86400

# _valid_model <client> <id> — the per-client --model / config admission rule.
_valid_model() {
    case "$1" in
    claude) [ "$2" = haiku ] || [ "$2" = sonnet ] || [ "$2" = opus ] ;;
    codex) [[ "$2" =~ $CODEX_MODEL_RE ]] ;;
    antigravity) [[ "$2" =~ $AGY_MODEL_RE ]] ;;
    *) return 1 ;;
    esac
}

_valid_effort() {
    [ "$1" = low ] || [ "$1" = medium ] || [ "$1" = high ]
}

# _repo_field <client> <field> — value from <project root>/.docs/loom-models.json
# (tier 2); empty when the file is absent; fails closed when it is not JSON.
_repo_field() {
    local top cfg
    top=$(git rev-parse --show-toplevel 2>/dev/null) || top="$PWD"
    cfg="$top/.docs/loom-models.json"
    [ -f "$cfg" ] || return 0
    jq -e . "$cfg" >/dev/null 2>&1 || _fail "repository model config is not valid JSON: .docs/loom-models.json"
    jq -r --arg c "$1" --arg f "$2" '((.[$c]? // {}) | objects | .[$f]?) | strings' "$cfg" 2>/dev/null
}

# _codex_ambient_model — top-level `model = "..."` from ~/.codex/config.toml
# (tier 3); empty when absent; fails closed when malformed or unsupported.
_codex_ambient_model() {
    local cfg="${HOME:-}/.codex/config.toml" line val
    [ -n "${HOME:-}" ] && [ -f "$cfg" ] || return 0
    line=$(awk '/^[[:space:]]*\[/{exit} /^[[:space:]]*model[[:space:]]*=/{print; exit}' "$cfg")
    [ -n "$line" ] || return 0
    val=$(printf '%s' "$line" | sed -n 's/^[[:space:]]*model[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p')
    [ -n "$val" ] || _fail "ambient Codex model is malformed in config.toml"
    _valid_model codex "$val" || _fail "ambient Codex model is unsupported: $val"
    printf '%s' "$val"
}

# _codex_ambient_effort — top-level `model_reasoning_effort = "..."` from
# ~/.codex/config.toml (tier 3); empty when absent; fails closed when invalid.
_codex_ambient_effort() {
    local cfg="${HOME:-}/.codex/config.toml" line val
    [ -n "${HOME:-}" ] && [ -f "$cfg" ] || return 0
    line=$(awk '/^[[:space:]]*\[/{exit} /^[[:space:]]*model_reasoning_effort[[:space:]]*=/{print; exit}' "$cfg")
    [ -n "$line" ] || return 0
    val=$(printf '%s' "$line" | sed -n 's/^[[:space:]]*model_reasoning_effort[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p')
    _valid_effort "$val" || _fail "ambient Codex model_reasoning_effort is invalid in config.toml"
    printf '%s' "$val"
}

# _agy_models — available Antigravity model ids, one per line: a fresh (<= 24h)
# owner-only cache, else `agy models` written back atomically (mode 0600).
# Returns 1 when neither source is usable (caller falls back to the floor).
_agy_models() {
    local cache now fetched age bin ids dir tmp
    cache="${XDG_CACHE_HOME:-${HOME:-}/.cache}/loom/agy-models.json"
    now=$(date +%s)
    # shellcheck disable=SC2012 # only the permission string of one known file is read
    if [ -f "$cache" ] && [ ! -L "$cache" ] && [ "$(ls -l "$cache" | cut -c5-10)" = "------" ]; then
        fetched=$(jq -r 'if (.fetchedAt | type) == "number" and (.models | type) == "array" then .fetchedAt else empty end' "$cache" 2>/dev/null)
        case "$fetched" in
        "" | *[!0-9]*) ;;
        *)
            age=$((now - fetched))
            if [ "$age" -ge 0 ] && [ "$age" -le "$AGY_CACHE_TTL" ]; then
                jq -r '.models[] | strings' "$cache"
                return 0
            fi
            ;;
        esac
    fi
    bin="${LOOM_LAUNCH_ROLE_AGY_BIN:-agy}"
    command -v "$bin" >/dev/null 2>&1 || return 1
    ids=$("$bin" models 2>/dev/null) || return 1
    ids=$(printf '%s\n' "$ids" | awk -F'\t' 'NF >= 2 && $1 ~ /^[a-z0-9][a-z0-9._-]*$/ {print $1}')
    [ -n "$ids" ] || return 1
    dir=$(dirname -- "$cache")
    if (umask 077 && mkdir -p "$dir") && tmp=$(umask 077 && mktemp "$dir/agy-models.XXXXXX" 2>/dev/null); then
        if printf '%s\n' "$ids" | jq -Rn --argjson t "$now" '{fetchedAt: $t, models: [inputs | select(length > 0)]}' >"$tmp" 2>/dev/null &&
            chmod 600 "$tmp" && mv -f "$tmp" "$cache"; then
            :
        else
            rm -f "$tmp"
        fi
    fi
    printf '%s\n' "$ids"
}

# _agy_pick <models> <profile> <effort> — newest model of the profile's family
# carrying the effort suffix; empty when none matches.
_agy_pick() {
    local family
    case "$2" in
    Economy) family=flash ;;
    Standard) family=sonnet ;;
    "Deep review") family=opus ;;
    *) return 0 ;;
    esac
    printf '%s\n' "$1" | grep -E -- "${family}.*-$3\$" | sort -rV | head -n 1
}

_launch_claude() {
    local root="$1" role="$2" profile="$3" selector="$4" cross_json="${5:-}" matrix_selector="${6:-$4}"
    local agent_path model tools cold_id
    agent_path="$root/agents/$role.md"
    [ -f "$agent_path" ] || _fail "agent adapter is missing: $role"
    model=$(_frontmatter_field "$agent_path" model) || _fail "agent adapter has no model field: $role"
    tools=$(_frontmatter_field "$agent_path" tools) || _fail "agent adapter has no tools field: $role"
    [ "$model" = "$matrix_selector" ] || _fail "agent adapter model does not match the compatibility matrix tier: $role"
    _csv_contains "$tools" "Agent" && _fail "agent adapter grants the forbidden Agent capability: $role"
    cold_id=$(_cold_id) || _fail "cannot generate a cold launch id"
    printf '{"schema":"loom-role-launch/v1","client":"claude","role":"%s","profile":"%s","coldId":"%s","cold":true,"delegation":false,"permissions":"one-level"%s,"claude":{"selector":"%s","agentCapability":false}}\n' \
        "$role" "$profile" "$cold_id" "$cross_json" "$selector"
}

_launch_codex() {
    local root="$1" role="$2" profile="$3" model="$4" effort="$5" cross_json="${6:-}"
    local skill_path schema_path cold_id argv codex_bin
    skill_path="$root/skills/loom-$role/SKILL.md"
    [ -f "$skill_path" ] || _fail "codex role skill is missing: $role"
    schema_path="$root/schemas/loom-role-launch-v1.schema.json"
    [ -f "$schema_path" ] || _fail "closed bounded-output schema is missing"
    cold_id=$(_cold_id) || _fail "cannot generate a cold launch id"
    argv=(
        exec --ephemeral --ignore-user-config --strict-config --disable multi_agent
        --sandbox read-only --model "$model" -c "model_reasoning_effort=$effort"
        -c "tools.web_search=false" --output-schema "$schema_path" "\$loom-$role"
    )
    printf '{"schema":"loom-role-launch/v1","client":"codex","role":"%s","profile":"%s","coldId":"%s","cold":true,"delegation":false,"permissions":"one-level"%s,"codex":{"model":"%s","effort":"%s","sandbox":"read-only","webSearch":false,"argv":%s}}\n' \
        "$role" "$profile" "$cold_id" "$cross_json" "$model" "$effort" "$(_json_argv_array "${argv[@]}")"
    codex_bin="${LOOM_LAUNCH_ROLE_CODEX_BIN:-codex}"
    exec env LOOM_LAUNCH_ROLE_ACTIVE=1 LOOM_ROLE="$role" "$codex_bin" "${argv[@]}"
}

_launch_antigravity() {
    local root="$1" role="$2" profile="$3" cross_json="${4:-}" ag_model="${5:-}" effort="${6:-}"
    local role_path roles_dir role_sha cold_id models picked
    [ -d "$root/roles" ] && [ ! -L "$root/roles" ] || _fail "roles directory is missing or symlinked"
    roles_dir=$(_canon_dir "$root/roles") || _fail "cannot canonicalize roles directory"
    role_path="$roles_dir/$role.md"
    [ -f "$role_path" ] && [ ! -L "$role_path" ] || _fail "canonical role contract is missing or symlinked: $role"
    role_sha=$(_sha256_file "$role_path") || _fail "cannot hash canonical role contract: $role"
    case "$profile" in
    Economy) [ -n "$effort" ] || effort=low ;;
    Standard) [ -n "$effort" ] || effort=medium ;;
    "Deep review") [ -n "$effort" ] || effort=high ;;
    *) _fail "unsupported profile for Antigravity model mapping: $profile" ;;
    esac
    if [ -z "$ag_model" ]; then
        models=$(_agy_models) || models=""
        picked=""
        [ -z "$models" ] || picked=$(_agy_pick "$models" "$profile" "$effort")
        if [ -n "$picked" ]; then
            ag_model="$picked"
        else
            case "$profile" in
            Economy) ag_model="flash" ;;
            Standard) ag_model="inherit" ;;
            *) ag_model="pro" ;;
            esac
        fi
    fi
    cold_id=$(_cold_id) || _fail "cannot generate a cold launch id"
    printf '{"schema":"loom-role-launch/v1","client":"antigravity","role":"%s","profile":"%s","coldId":"%s","cold":true,"delegation":false,"permissions":"one-level"%s,"antigravity":{"subagentName":"loom-%s","model":"%s","enableSubagentTools":false,"enableWriteTools":true,"rolePromptPath":"%s","rolePromptSha256":"%s","environment":{"LOOM_ROLE":"%s"}}}\n' \
        "$role" "$profile" "$cold_id" "$cross_json" "$role" "$(_json_escape "$ag_model")" "$(_json_escape "$role_path")" "$role_sha" "$role"
}

main() {
    [ "$#" -ge 2 ] || _usage
    local client="$1" role="$2"
    shift 2
    if [ "$client" != "auto" ] && ! _is_member "$client" "${CLIENTS[@]}"; then
        _usage
    fi
    _is_member "$role" "${ROLES[@]}" || _usage

    local author_client="${LOOM_AUTHOR_CLIENT:-}"
    local routing_file="${LOOM_ROUTING_FILE:-}"
    local flag_model="" flag_effort="" flag_model_set=0 flag_effort_set=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
        --author-client)
            [ "$#" -ge 2 ] || _usage
            author_client="$2"
            shift 2
            ;;
        --routing-file)
            [ "$#" -ge 2 ] || _usage
            routing_file="$2"
            shift 2
            ;;
        --model)
            [ "$#" -ge 2 ] || _usage
            flag_model="$2"
            flag_model_set=1
            shift 2
            ;;
        --effort)
            [ "$#" -ge 2 ] || _usage
            flag_effort="$2"
            flag_effort_set=1
            shift 2
            ;;
        *)
            _usage
            ;;
        esac
    done
    if [ "$flag_effort_set" -eq 1 ]; then
        _valid_effort "$flag_effort" || _fail "invalid --effort (expected low, medium, or high): $flag_effort"
    fi

    case "$0" in
    /*) ;;
    *) _fail "must be invoked by absolute path" ;;
    esac

    _guard_descendant
    _guard_vendor_override
    _guard_delegation_env

    command -v jq >/dev/null 2>&1 || _fail "jq is required"

    local require_cross_family=0
    case "${LOOM_REQUIRE_CROSS_FAMILY_EVAL:-}" in
    "" | 0 | false | no) ;;
    *) require_cross_family=1 ;;
    esac

    if [ -n "$routing_file" ]; then
        case "$routing_file" in
        /*) ;;
        *) _fail "routing file must be an absolute path" ;;
        esac
        [ -f "$routing_file" ] && [ ! -L "$routing_file" ] || _fail "routing file is missing or symlinked"
        local routing_json routing_schema routing_require_cross
        routing_json=$(cat -- "$routing_file" 2>/dev/null) || _fail "cannot read routing file"
        routing_schema=$(printf '%s' "$routing_json" | jq -r '.schema // empty' 2>/dev/null) || _fail "routing file is not valid JSON"
        [ "$routing_schema" = "loom-role-routing/v1" ] || _fail "routing file schema mismatch"
        routing_require_cross=$(printf '%s' "$routing_json" | jq -r 'if .requireCrossFamilyEval == true then "1" else "0" end')
        if [ "$routing_require_cross" = "1" ]; then
            require_cross_family=1
            if [ -z "$author_client" ]; then
                case "$role" in
                plan-evaluator)
                    author_client=$(printf '%s' "$routing_json" | jq -r '.routes["planner"] // empty')
                    ;;
                code-evaluator)
                    author_client=$(printf '%s' "$routing_json" | jq -r '.routes["developer"] // empty')
                    ;;
                esac
            fi
        fi
        if [ "$client" = "auto" ]; then
            client=$(printf '%s' "$routing_json" | jq -r --arg r "$role" '.routes[$r] // empty')
            [ -n "$client" ] || _fail "no client route mapped for role: $role"
            _is_member "$client" "${CLIENTS[@]}" || _fail "invalid routed client for role $role: $client"
        fi
    fi

    if [ -n "$author_client" ]; then
        _is_member "$author_client" "${CLIENTS[@]}" || _fail "invalid author client: $author_client"
    fi

    if [ "$client" = "auto" ]; then
        case "$role" in
        plan-evaluator | code-evaluator)
            [ -n "$author_client" ] || _fail "cross-family evaluation required but no author client was supplied"
            client=$(_next_client_in_cycle "$author_client") || _fail "cannot resolve auto client for author: $author_client"
            ;;
        *)
            _fail "auto client requires --routing-file for role: $role"
            ;;
        esac
    fi

    local cross_json=""
    case "$role" in
    plan-evaluator | code-evaluator)
        if [ "$require_cross_family" -eq 1 ] && [ -z "$author_client" ]; then
            _fail "cross-family evaluation required but no author client was supplied"
        fi
        if [ -n "$author_client" ]; then
            if [ "$client" = "$author_client" ]; then
                _fail "cross-family evaluation violation: $role client ($client) matches author client ($author_client)"
            fi
            cross_json=$(printf ',"authorClient":"%s","crossFamilyVerified":true' "$(_json_escape "$author_client")")
        fi
        ;;
    esac

    local script_dir root matrix_path matrix_json schema_ok matrix_version role_key profile
    script_dir=$(_canon_dir "$(dirname -- "$0")") || _fail "cannot canonicalize script directory"
    root=$(_canon_dir "$script_dir/..") || _fail "cannot canonicalize plugin root"
    matrix_path="$root/adapters/compatibility/v0.3.0.json"
    [ -f "$matrix_path" ] || _fail "compatibility matrix is missing"
    matrix_json=$(cat -- "$matrix_path" 2>/dev/null) || _fail "cannot read compatibility matrix"
    schema_ok=$(printf '%s' "$matrix_json" | jq -r '.schema // empty' 2>/dev/null) || _fail "compatibility matrix is not valid JSON"
    [ "$schema_ok" = "loom-compatibility-matrix/v1" ] || _fail "compatibility matrix schema mismatch"
    matrix_version=$(printf '%s' "$matrix_json" | jq -r '.version // empty')
    [ "$matrix_version" = "0.3.0" ] || _fail "compatibility matrix version mismatch"

    role_key=$(_role_key "$role")
    profile=$(printf '%s' "$matrix_json" | jq -r --arg r "$role_key" '[.profiles[] | select(.consumers[]? == $r)] | .[0].profile // empty')
    [ -n "$profile" ] || _fail "no profile mapped for role: $role"

    local model_in="$flag_model" effort_in="$flag_effort"
    [ "$flag_model_set" -eq 0 ] || _valid_model "$client" "$flag_model" || _fail "invalid --model for $client: $flag_model"
    if [ "$flag_model_set" -eq 0 ]; then
        model_in=$(_repo_field "$client" model) || exit 2
        [ -z "$model_in" ] || _valid_model "$client" "$model_in" || _fail "invalid repository model for $client: $model_in"
    fi
    if [ "$flag_effort_set" -eq 0 ]; then
        effort_in=$(_repo_field "$client" effort) || exit 2
        [ -z "$effort_in" ] || _valid_effort "$effort_in" || _fail "invalid repository effort for $client: $effort_in"
    fi

    case "$client" in
    claude)
        local selector
        selector=$(_matrix_field "$matrix_json" "$profile" ".claude.selector")
        [ -n "$selector" ] || _fail "no Claude selector mapped for profile: $profile"
        _launch_claude "$root" "$role" "$profile" "${model_in:-$selector}" "$cross_json" "$selector"
        ;;
    codex)
        local model effort
        model="$model_in"
        [ -n "$model" ] || model=$(_codex_ambient_model) || exit 2
        [ -n "$model" ] || model=$(_matrix_field "$matrix_json" "$profile" ".codex.model")
        effort="$effort_in"
        [ -n "$effort" ] || effort=$(_codex_ambient_effort) || exit 2
        [ -n "$effort" ] || effort=$(_matrix_field "$matrix_json" "$profile" ".codex.effort")
        [ -n "$model" ] || _fail "no Codex model mapped for profile: $profile"
        [ -n "$effort" ] || _fail "no Codex effort mapped for profile: $profile"
        _launch_codex "$root" "$role" "$profile" "$model" "$effort" "$cross_json"
        ;;
    antigravity)
        _launch_antigravity "$root" "$role" "$profile" "$cross_json" "$model_in" "$effort_in"
        ;;
    esac
}

main "$@"

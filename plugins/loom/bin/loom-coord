#!/usr/bin/env bash
# loom-coord — Multi-session lock/claim coordination helper (ADR 0014)
# Ships in the plugin's bin/ (on $PATH when loom is enabled); invoke as the bare command `loom-coord`.
#
# Hand-invoked CLI helper (NOT a hook — not registered in hooks.json).
# Serializes N independent /loom:run sessions writing to the shared main
# checkout through a git-CAS lock (refs/loom/lock) and a slice-lease protocol.
#
# FAIL DIRECTION: fail-closed (opposite of the guard hooks).
#   The guard hooks fail-open (false block > missed guard).
#   A coordination helper must fail-closed: on any tooling/parse ambiguity
#   it denies — never grants a lock or claim it cannot prove is safe —
#   because a falsely-granted lock or double-granted claim corrupts main.
#   Every error branch exits non-zero; exit 0 means "provably safe".
#
# State paths:
#   refs/loom/lock                  — git ref (git-CAS lock; blob = {sid}\t{ts}\t{pid}\t\n)
#   refs/loom/claims/<slice>        — git ref per slice (blob = {sid}\t{ts}\n)
#   $STATE_DIR/session-<id>/        — per-session dir
#   $STATE_DIR/session-<id>/checkpoint    — write-ahead next action
#   $STATE_DIR/session-<id>/held-claims   — one slice name per line
#   $STATE_DIR/session-<id>/session.pid   — stable session process pid
#   $STATE_DIR/session-<id>/session.starttime — session process start-time
#   $STATE_DIR/session-<id>/renewer.pid   — background renewer pid
#   $STATE_DIR/session-<id>/renewer.starttime — renewer start-time
#
# Exit codes:
#   0  — success
#   1  — usage / missing-argument error
#   3  — lock busy (backoff exhausted)
#   4  — claim taken by a live peer (caller must abort + re-select)
#   5  — precondition violation (lock not held by self / claim not owned by self)
#   6  — reclaim refused (target holder still alive)
#   10 — fail-closed: tooling/parse ambiguity (git unavailable, not a repo,
#         unreadable state) — deny

# ---------------------------------------------------------------------------
# Tunable parameters (overridable via env)
# ---------------------------------------------------------------------------
# X1 fix: _norm_int strips leading zeros to normalize to base-10.
# Bash arithmetic treats 08/09 as invalid octal, so normalize before use.
_norm_int() {
    local _ni
    _ni="$1"
    while [ "${#_ni}" -gt 1 ]; do
        case "$_ni" in
        0*) _ni="${_ni#0}" ;;
        *) break ;;
        esac
    done
    printf '%s' "$_ni"
}

# X6 fix: floor LOOM_LOCK_TTL to 2 (minimum) so the heartbeat interval can
# always be set strictly < TTL (TTL=1 has no valid sub-TTL integer interval).
LOOM_LOCK_TTL="${LOOM_LOCK_TTL:-30}"
case "$LOOM_LOCK_TTL" in
*[!0-9]* | '') LOOM_LOCK_TTL=30 ;;
*) LOOM_LOCK_TTL=$(_norm_int "$LOOM_LOCK_TTL") ;;
esac
[ "$LOOM_LOCK_TTL" -lt 2 ] && LOOM_LOCK_TTL=2

LOOM_LEASE_TTL="${LOOM_LEASE_TTL:-3600}"
case "$LOOM_LEASE_TTL" in
*[!0-9]* | '') LOOM_LEASE_TTL=3600 ;;
*) LOOM_LEASE_TTL=$(_norm_int "$LOOM_LEASE_TTL") ;;
esac
[ "$LOOM_LEASE_TTL" -lt 1 ] && LOOM_LEASE_TTL=1

LOOM_LOCK_RETRIES="${LOOM_LOCK_RETRIES:-5}"
case "$LOOM_LOCK_RETRIES" in
*[!0-9]* | '') LOOM_LOCK_RETRIES=5 ;;
*) LOOM_LOCK_RETRIES=$(_norm_int "$LOOM_LOCK_RETRIES") ;;
esac
[ "$LOOM_LOCK_RETRIES" -lt 1 ] && LOOM_LOCK_RETRIES=1

LOOM_RENEW_INTERVAL="${LOOM_RENEW_INTERVAL:-1200}"
case "$LOOM_RENEW_INTERVAL" in
*[!0-9]* | '') LOOM_RENEW_INTERVAL=1200 ;;
*) LOOM_RENEW_INTERVAL=$(_norm_int "$LOOM_RENEW_INTERVAL") ;;
esac
[ "$LOOM_RENEW_INTERVAL" -lt 1 ] && LOOM_RENEW_INTERVAL=1

# Lock-heartbeat cadence (V1 fix): must be strictly < LOOM_LOCK_TTL (~TTL/3).
# Default derived from LOOM_LOCK_TTL; override with LOOM_LOCK_RENEW_INTERVAL.
_default_lri=$((LOOM_LOCK_TTL / 3))
[ "$_default_lri" -lt 1 ] && _default_lri=1
LOOM_LOCK_RENEW_INTERVAL="${LOOM_LOCK_RENEW_INTERVAL:-$_default_lri}"
# W1 fix: validate override — floor at 1 (prevents division-by-zero at the
# renewer's _lease_every computation) and clamp below LOOM_LOCK_TTL (prevents
# heartbeating slower than the lock expires → peer-steal of a live holder).
# X1 fix: normalize leading zeros after digit-check (same zero-pad crash).
# X6 fix: LOOM_LOCK_TTL >= 2 ensures _default_lri >= 1 < TTL is always safe.
case "$LOOM_LOCK_RENEW_INTERVAL" in
*[!0-9]* | '') LOOM_LOCK_RENEW_INTERVAL=$_default_lri ;;
*) LOOM_LOCK_RENEW_INTERVAL=$(_norm_int "$LOOM_LOCK_RENEW_INTERVAL") ;;
esac
[ "$LOOM_LOCK_RENEW_INTERVAL" -lt 1 ] && LOOM_LOCK_RENEW_INTERVAL=1
if [ "$LOOM_LOCK_RENEW_INTERVAL" -ge "$LOOM_LOCK_TTL" ]; then
    LOOM_LOCK_RENEW_INTERVAL=$_default_lri
    [ "$LOOM_LOCK_RENEW_INTERVAL" -lt 1 ] && LOOM_LOCK_RENEW_INTERVAL=1
fi

# ---------------------------------------------------------------------------
# Arg parsing — subcommand and --session
# ---------------------------------------------------------------------------
SUBCOMMAND=""
SESSION_ID="${LOOM_SESSION_ID:-}"
EXTRA_ARGS=""

if [ $# -eq 0 ]; then
    printf 'loom-coord: no subcommand given\n' >&2
    exit 1
fi

SUBCOMMAND="$1"
shift

# Parse remaining args for --session and positional
while [ $# -gt 0 ]; do
    case "$1" in
    --session)
        if [ $# -lt 2 ]; then
            printf 'loom-coord: --session requires a value\n' >&2
            exit 1
        fi
        SESSION_ID="$2"
        shift 2
        ;;
    --session=*)
        SESSION_ID="${1#--session=}"
        shift
        ;;
    *)
        if [ -z "$EXTRA_ARGS" ]; then
            EXTRA_ARGS="$1"
        else
            EXTRA_ARGS="$EXTRA_ARGS $1"
        fi
        shift
        ;;
    esac
done

# ---------------------------------------------------------------------------
# State resolution — fail-closed on any git error
# ---------------------------------------------------------------------------
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then
    printf 'loom-coord: not a git repo or git unavailable\n' >&2
    exit 10
fi

GITDIR=$(git -C "$REPO_ROOT" rev-parse --git-dir 2>/dev/null)
if [ -z "$GITDIR" ]; then
    printf 'loom-coord: cannot resolve git-dir\n' >&2
    exit 10
fi
case "$GITDIR" in
/*) ;;
*) GITDIR="$REPO_ROOT/$GITDIR" ;;
esac

STATE_DIR="$GITDIR/loom"
LOCK_REF="refs/loom/lock"
CLAIMS_REF_PREFIX="refs/loom/claims"
NULL_SHA="0000000000000000000000000000000000000000"
# W3: ref-schema version marker — fail-closed if a different version is found
# (detects concurrent old+new version collision or future scheme changes).
SCHEMA_VERSION="2"
SCHEMA_REF="refs/loom/schema"

# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

now() {
    date +%s 2>/dev/null
}

# _valid_identifier <value> — returns 0 iff <value> matches the safe grammar
#   [A-Za-z0-9][A-Za-z0-9._-]{0,127}  AND contains no ".." substring.
# Bash 3.2 / BSD safe: pure case-glob + ${#}.  The single [!A-Za-z0-9._-]
# rejection covers "/", spaces, tabs, newlines, control bytes, and every
# multibyte Unicode separator (their bytes fall outside the allowed set).
#
# This is the grammar for identifiers that form paths, refs, or process
# arguments — session ids (user-supplied and decoded-from-blob) and, via
# validate_pid, PIDs.  It is NOT applied to slice names (see below).
_valid_identifier() {
    local v="$1"
    [ -n "$v" ] || return 1                      # empty
    [ "${#v}" -le 128 ] || return 1              # overlong (1 + up to 127)
    case "$v" in [!A-Za-z0-9]*) return 1 ;; esac # leading char must be alnum
    case "$v" in
    *[!A-Za-z0-9._-]*) return 1 ;; # any byte outside the allowed set
    *..*) return 1 ;;              # explicit ".." reject (literal M1 requirement)
    esac
    return 0
}

# _valid_slice_name <value> — returns 0 iff <value> is a legal held-claims record:
#   non-empty AND contains no newline, tab, or other control byte.
#   Slice names are hash-consumed for the ref (V5) and base64'd into the blob (W2),
#   so ":" and ".." are SAFE and must remain claimable (SC1, V5b, V5/V6 capability).
#   The ONLY invariant to protect is the session-<id>/held-claims one-record-per-line
#   format, which control bytes (esp. newline/tab) would corrupt.
# Bash 3.2 / BSD safe: pure case-glob with the POSIX [[:cntrl:]] class.
_valid_slice_name() {
    local v="$1"
    [ -n "$v" ] || return 1                      # empty
    case "$v" in *[[:cntrl:]]*) return 1 ;; esac # newline, tab, any control byte
    return 0
}

# validate_session_id <value> — exit 1 with a usage message unless _valid_identifier.
validate_session_id() {
    if ! _valid_identifier "$1"; then
        printf 'loom-coord %s: invalid session id (expected [A-Za-z0-9][A-Za-z0-9._-]{0,127}, no "..")\n' "$SUBCOMMAND" >&2
        exit 1
    fi
}

# validate_slice_name <value> — exit 1 with a usage message unless _valid_slice_name.
validate_slice_name() {
    if ! _valid_slice_name "$1"; then
        printf 'loom-coord %s: invalid slice name (must be non-empty with no newline/tab/control bytes)\n' "$SUBCOMMAND" >&2
        exit 1
    fi
}

# validate_pid <value> — exit 1 with a usage message unless <value> is digits-only.
validate_pid() {
    case "$1" in
    '' | *[!0-9]*)
        printf 'loom-coord %s: invalid pid (expected digits)\n' "$SUBCOMMAND" >&2
        exit 1
        ;;
    esac
    [ "${#1}" -le 20 ] || {
        printf 'loom-coord %s: pid too long\n' "$SUBCOMMAND" >&2
        exit 1
    }
}

# _physical_dir <dir> — print the physical path of an existing real directory.
# `cd -P` + `pwd -P` is available in Bash 3.2 and on both supported host families;
# unlike realpath/readlink/stat it has no GNU/BSD option split.
_physical_dir() (
    [ ! -L "$1" ] && [ -d "$1" ] || return 1
    CDPATH='' cd -P -- "$1" 2>/dev/null || return 1
    pwd -P
)

# _state_dir_enter <create|existing> — enter the physical state root and prove it
# is exactly the `loom` child of the physical git dir.  The caller runs in a
# subshell, so subsequent relative operations retain the verified directory inode
# even if the pathname is swapped concurrently.
_state_dir_enter() {
    local _mode="$1" _git_phys _state_phys _expected
    _git_phys=$(_physical_dir "$GITDIR") || return 10
    _expected="${_git_phys%/}/loom"

    if [ ! -e "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ]; then
        [ "$_mode" = "create" ] || return 20
        mkdir "$STATE_DIR" 2>/dev/null || return 10
    fi
    [ ! -L "$STATE_DIR" ] && [ -d "$STATE_DIR" ] || return 10
    _state_phys=$(_physical_dir "$STATE_DIR") || return 10
    [ "$_state_phys" = "$_expected" ] || return 10
    CDPATH='' cd -P -- "$STATE_DIR" 2>/dev/null || return 10
    [ "$(pwd -P)" = "$_expected" ] || return 10
}

# _with_session_dir <sid> <create|require|optional> <operation> [args...]
#
# This is the single session-state boundary.  It validates the existing identifier
# grammar, verifies/enters the physical state root, inspects the session entry
# without following symlinks, optionally creates it, then enters and rechecks its
# physical location before invoking an operation relative to that directory.
# Return 20 means an optional/required session is absent; return 10 means unsafe
# persisted state or another containment ambiguity.
_with_session_dir() (
    local _sid="$1" _mode="$2" _operation="$3"
    local _entry _state_phys _session_phys _expected _state_mode
    shift 3
    _valid_identifier "$_sid" || return 10
    _state_mode="existing"
    [ "$_mode" = "create" ] && _state_mode="create"
    _state_dir_enter "$_state_mode" || return $?
    _state_phys=$(pwd -P) || return 10
    _entry="session-$_sid"

    if [ ! -e "$_entry" ] && [ ! -L "$_entry" ]; then
        [ "$_mode" = "create" ] || return 20
        mkdir "$_entry" 2>/dev/null || return 10
    fi
    [ ! -L "$_entry" ] && [ -d "$_entry" ] || return 10
    _expected="${_state_phys%/}/$_entry"
    _session_phys=$(_physical_dir "$_entry") || return 10
    [ "$_session_phys" = "$_expected" ] || return 10
    CDPATH='' cd -P -- "$_entry" 2>/dev/null || return 10
    [ "$(pwd -P)" = "$_expected" ] || return 10
    "$_operation" "$@"
)

_session_child_regular_or_absent() {
    [ ! -L "$1" ] || return 10
    if [ -e "$1" ]; then
        [ -f "$1" ] || return 10
    fi
}

_session_create_empty_child() {
    local _child="$1"
    _session_child_regular_or_absent "$_child" || return $?
    [ -e "$_child" ] && return 0
    (
        set -C
        : >"$_child"
    ) 2>/dev/null || {
        _session_child_regular_or_absent "$_child" || return $?
        [ -f "$_child" ] || return 10
    }
}

_session_atomic_replace() {
    local _child="$1" _value_mode="$2" _value="${3:-}" _tmp
    _session_child_regular_or_absent "$_child" || return $?
    _tmp="${_child}.tmp.$$"
    [ ! -e "$_tmp" ] && [ ! -L "$_tmp" ] || return 10
    if [ "$_value_mode" = "stdin" ]; then
        (
            set -C
            cat >"$_tmp"
        ) 2>/dev/null || {
            rm -f "$_tmp" 2>/dev/null || true
            return 10
        }
    else
        (
            set -C
            printf '%s\n' "$_value" >"$_tmp"
        ) 2>/dev/null || {
            rm -f "$_tmp" 2>/dev/null || true
            return 10
        }
    fi
    mv "$_tmp" "$_child" 2>/dev/null || {
        rm -f "$_tmp" 2>/dev/null || true
        return 10
    }
}

_session_init_op() {
    _session_create_empty_child checkpoint || return $?
    _session_create_empty_child held-claims
}

_session_checkpoint_write_op() {
    if [ -n "$EXTRA_ARGS" ]; then
        _session_atomic_replace checkpoint value "$EXTRA_ARGS"
    else
        _session_atomic_replace checkpoint stdin
    fi
}

_session_checkpoint_read_op() {
    _session_child_regular_or_absent checkpoint || return $?
    [ -f checkpoint ] || return 21
    cat checkpoint
}

_session_held_preflight_op() {
    _session_create_empty_child held-claims
}

_session_validate_held_op() {
    _session_child_regular_or_absent held-claims
}

_session_add_held_claim_op() {
    local _slice="$1" _tmp
    _session_create_empty_child held-claims || return $?
    grep -qxF "$_slice" held-claims 2>/dev/null && return 0
    _tmp="held-claims.tmp.$$"
    [ ! -e "$_tmp" ] && [ ! -L "$_tmp" ] || return 10
    (
        set -C
        cat held-claims
        printf '%s\n' "$_slice"
    ) >"$_tmp" 2>/dev/null || {
        rm -f "$_tmp" 2>/dev/null || true
        return 10
    }
    mv "$_tmp" held-claims 2>/dev/null || {
        rm -f "$_tmp" 2>/dev/null || true
        return 10
    }
}

_session_remove_held_claim_op() {
    local _slice="$1" _tmp
    _session_child_regular_or_absent held-claims || return $?
    [ -f held-claims ] || return 0
    _tmp="held-claims.tmp.$$"
    [ ! -e "$_tmp" ] && [ ! -L "$_tmp" ] || return 10
    (
        set -C
        grep -vxF "$_slice" held-claims >"$_tmp"
    ) 2>/dev/null || {
        [ -f "$_tmp" ] || return 10
    }
    mv "$_tmp" held-claims 2>/dev/null || {
        rm -f "$_tmp" 2>/dev/null || true
        return 10
    }
}

_session_copy_held_claims_op() {
    local _destination="$1"
    _session_child_regular_or_absent held-claims || return $?
    [ -f held-claims ] || return 21
    cat held-claims >"$_destination"
}

_session_write_process_state_op() {
    local _prefix="$1" _pid="$2" _start="$3"
    _session_atomic_replace "$_prefix.pid" value "$_pid" || return $?
    if [ -n "$_start" ]; then
        _session_atomic_replace "$_prefix.starttime" value "$_start"
    else
        _session_child_regular_or_absent "$_prefix.starttime" || return $?
        rm -f "$_prefix.starttime"
    fi
}

_session_read_process_state_op() {
    local _prefix="$1" _pid _start
    _session_child_regular_or_absent "$_prefix.pid" || return $?
    _session_child_regular_or_absent "$_prefix.starttime" || return $?
    [ -f "$_prefix.pid" ] || return 21
    _pid=$(cat "$_prefix.pid") || return 10
    _start=""
    if [ -f "$_prefix.starttime" ]; then
        _start=$(cat "$_prefix.starttime") || return 10
    fi
    printf '%s\n%s\n' "$_pid" "$_start"
}

_session_remove_renewer_state_op() {
    _session_child_regular_or_absent renewer.pid || return $?
    _session_child_regular_or_absent renewer.starttime || return $?
    rm -f renewer.pid renewer.starttime
}

_session_remove_op() {
    local _entry
    _entry=$(basename "$(pwd -P)") || return 10
    rm -f checkpoint held-claims \
        session.pid session.starttime renewer.pid renewer.starttime 2>/dev/null || true
    rm -f ./*.tmp.* 2>/dev/null || true
    CDPATH='' cd -P .. 2>/dev/null || return 10
    rmdir "$_entry" 2>/dev/null || true
}

# _remove_session_dir <sid> — delete only known entries from a reverified real
# session directory, then rmdir it if empty.  Unsafe objects are quarantined.
_remove_session_dir() {
    _with_session_dir "$1" optional _session_remove_op
}

# _check_or_set_schema — verify refs/loom/schema matches SCHEMA_VERSION (W3 + coord-schema-cas).
# Fail-closed (exit 10) on any hash, read, parse, or update failure, or when an
# incompatible version is found. Initializes refs/loom/schema with a null-SHA
# create-only CAS; if the CAS loses a race, re-reads and verifies the winner's version.
_check_or_set_schema() {
    local _cur_sha _cur_ver _new_sha
    _cur_sha=$(git -C "$REPO_ROOT" rev-parse --verify "$SCHEMA_REF" 2>/dev/null || true)
    if [ -z "$_cur_sha" ]; then
        _new_sha=$(printf '%s' "$SCHEMA_VERSION" |
            git -C "$REPO_ROOT" hash-object -w --stdin 2>/dev/null) || _new_sha=""
        if [ -z "$_new_sha" ]; then
            printf 'loom-coord: cannot create schema blob\n' >&2
            exit 10
        fi
        if git -C "$REPO_ROOT" update-ref "$SCHEMA_REF" "$_new_sha" "$NULL_SHA" 2>/dev/null; then
            return 0
        fi
        _cur_sha=$(git -C "$REPO_ROOT" rev-parse --verify "$SCHEMA_REF" 2>/dev/null || true)
        if [ -z "$_cur_sha" ]; then
            printf 'loom-coord: cannot initialize schema ref\n' >&2
            exit 10
        fi
    fi
    _cur_ver=$(git -C "$REPO_ROOT" cat-file blob "$_cur_sha" 2>/dev/null) || _cur_ver=""
    if [ "$_cur_ver" != "$SCHEMA_VERSION" ]; then
        printf 'loom-coord: ref schema v%s found, expected v%s — aborting (incompatible version)\n' \
            "$_cur_ver" "$SCHEMA_VERSION" >&2
        exit 10
    fi
}

# read_lock_sha — print current SHA of refs/loom/lock, or empty if absent
read_lock_sha() {
    git -C "$REPO_ROOT" rev-parse --verify "$LOCK_REF" 2>/dev/null || true
}

# decode_lock_field <sha> <field-number> — read lock blob and print the Nth tab field
decode_lock_field() {
    local _sha="$1" _field="$2"
    git -C "$REPO_ROOT" cat-file blob "$_sha" 2>/dev/null |
        awk -F'\t' -v f="$_field" '{print $f}'
}

# _make_blob_for <sid> — write {sid}\t{ts}\t{pid}\t\n blob; print SHA or empty on failure
_make_blob_for() {
    local _msid="$1"
    printf '%s\t%s\t%s\t\n' "$_msid" "$(now)" "$$" |
        git -C "$REPO_ROOT" hash-object -w --stdin 2>/dev/null
}

# process_starttime <pid> — print the start-time of a process; empty on failure.
# Portable: tries Linux /proc/<pid>/stat (field 22, jiffies since boot — stable,
# locale-independent) first; falls back to BSD/macOS `ps -o lstart=`.
#
# Field 22 MUST be located by splitting on the LAST ')' because the comm field
# (field 2) is wrapped in parens and may itself contain spaces or ')' (e.g.
# "(a b) c)" is a legal comm).  Naïve `awk '{print $22}'` gives the wrong field
# in that case.  After the last ')', the fields are:
#   state(1) ppid(2) pgrp(3) session(4) tty_nr(5) tpgid(6) flags(7) minflt(8)
#   cminflt(9) majflt(10) cmajflt(11) utime(12) stime(13) cutime(14) cstime(15)
#   priority(16) nice(17) num_threads(18) itrealvalue(19) starttime(20)
process_starttime() {
    local _pid="$1"
    local _f="/proc/$_pid/stat"
    if [ -f "$_f" ]; then
        awk '{
            last = 0
            for (i = 1; i <= length($0); i++) {
                if (substr($0, i, 1) == ")") last = i
            }
            if (last == 0) next
            rest = substr($0, last + 2)
            n = split(rest, a, " ")
            if (n >= 20) print a[20]
        }' "$_f" 2>/dev/null
        return
    fi
    ps -o lstart= -p "$_pid" 2>/dev/null
}

# wt_sid_match <sid> — read git worktree list --porcelain from stdin;
# print the first worktree path whose LAST PATH SEGMENT equals "wt-<sid>".
# Uses awk ENVIRON (not -v) to avoid escape-sequence processing: awk -v applies
# backslash escape processing to the value, so a session-id like "foo\nbar"
# becomes "foo<newline>bar" and never matches the literal last segment (T3 fix).
# ENVIRON delivers the value byte-for-byte with no interpretation.
wt_sid_match() {
    local sid="$1"
    [ -z "$sid" ] && return
    LOOM_SID="$sid" awk '
        BEGIN { sid = ENVIRON["LOOM_SID"] }
        /^worktree / {
            path = substr($0, 10)
            n = split(path, parts, "/")
            if (parts[n] == "wt-" sid) { print path; exit }
        }
    '
}

# claim_is_fresh <epoch> — returns 0 (alive/fresh) if the claim epoch is within
# LOOM_LEASE_TTL of now.  This is the SOLE liveness signal for claims (ADR 0015):
# worktree-list membership and the process pid are NOT liveness gates.
# Fail-closed (U2): empty or non-numeric epoch is UNPARSEABLE → treat as FRESH
# (live). Never classify an unreadable lease as stale — that would allow reclaim
# of a live holder whose epoch write was partial or corrupt.
claim_is_fresh() {
    local _epoch="$1"
    local _now
    case "$_epoch" in
    '' | *[!0-9]*) return 0 ;;
    esac
    _now=$(now)
    [ $((_now - _epoch)) -lt "$LOOM_LEASE_TTL" ]
}

# _session_alive_op — run inside the verified session directory; returns 0 if
# the recorded session process is alive
# under the reuse-robust identity gate: pid alive AND start-time still matches.
# Used by the background renewer as its loop condition.
_session_alive_op() {
    local _spid _sst _cur_st
    _session_child_regular_or_absent session.pid || return 1
    _session_child_regular_or_absent session.starttime || return 1
    _spid=$(cat session.pid 2>/dev/null) || return 1
    [ -z "$_spid" ] && return 1
    _sst=$(cat session.starttime 2>/dev/null) || return 1
    kill -0 "$_spid" 2>/dev/null || return 1
    _cur_st=$(process_starttime "$_spid")
    [ "$_cur_st" = "$_sst" ]
}

# _session_alive <sid> — revalidate the boundary on every liveness read.
_session_alive() {
    _with_session_dir "$1" require _session_alive_op
}

# _renewer_alive_op — run inside the verified session directory; returns 0 if
# the recorded renewer process is alive
# under the reuse-robust identity gate.  Used for duplicate-suppression in
# renewer-start.
_renewer_alive_op() {
    local _rpid _rst _cur_st
    _session_child_regular_or_absent renewer.pid || return 1
    _session_child_regular_or_absent renewer.starttime || return 1
    _rpid=$(cat renewer.pid 2>/dev/null) || return 1
    [ -z "$_rpid" ] && return 1
    _rst=$(cat renewer.starttime 2>/dev/null) || return 1
    kill -0 "$_rpid" 2>/dev/null || return 1
    _cur_st=$(process_starttime "$_rpid")
    [ "$_cur_st" = "$_rst" ]
}

# _renewer_alive <sid> — revalidate the boundary on every liveness read.
_renewer_alive() {
    _with_session_dir "$1" require _renewer_alive_op
}

# backoff_sleep <attempt>  (0-indexed; 0.2 0.4 0.8 1.6 3.2)
backoff_sleep() {
    local attempt="$1"
    # Use bc for fractional sleep; fall back to integer ceiling
    local frac
    case "$attempt" in
    0) frac="0.2" ;;
    1) frac="0.4" ;;
    2) frac="0.8" ;;
    3) frac="1.6" ;;
    *) frac="3.2" ;;
    esac
    if sleep "$frac" 2>/dev/null; then
        return 0
    fi
    # integer fallback: ceiling of frac
    case "$attempt" in
    0 | 1) sleep 1 ;;
    2) sleep 1 ;;
    3) sleep 2 ;;
    *) sleep 4 ;;
    esac
}

# lock_acquire [sid] — centralized git-CAS lock acquisition (coord-lock-ownership).
# Returns:
#   0  — lock acquired by <sid>
#   3  — lock busy after LOOM_LOCK_RETRIES attempts
#   10 — cannot create lock blob
lock_acquire() {
    local _sid="${1:-$SESSION_ID}" _attempt=0 _new_sha _cur_sha _h_ts _cur_epoch _elapsed
    while true; do
        _new_sha=$(_make_blob_for "$_sid")
        if [ -z "$_new_sha" ]; then
            return 10
        fi
        if git -C "$REPO_ROOT" update-ref "$LOCK_REF" "$_new_sha" "$NULL_SHA" 2>/dev/null; then
            return 0
        fi
        _cur_sha=$(read_lock_sha)
        if [ -n "$_cur_sha" ]; then
            _h_ts=$(decode_lock_field "$_cur_sha" 2)
            case "$_h_ts" in
            '' | *[!0-9]*)
                # Non-numeric ts -> treat as fresh (fail-closed)
                ;;
            *)
                _cur_epoch=$(now)
                _elapsed=$((_cur_epoch - _h_ts))
                if [ "$_elapsed" -ge "$LOOM_LOCK_TTL" ]; then
                    _new_sha=$(_make_blob_for "$_sid")
                    if [ -z "$_new_sha" ]; then
                        return 10
                    fi
                    if git -C "$REPO_ROOT" update-ref "$LOCK_REF" "$_new_sha" "$_cur_sha" 2>/dev/null; then
                        return 0
                    fi
                fi
                ;;
            esac
        fi
        _attempt=$((_attempt + 1))
        if [ "$_attempt" -ge "$LOOM_LOCK_RETRIES" ]; then
            return 3
        fi
        backoff_sleep "$((_attempt - 1))"
    done
}

# lock_verify_self [sid] — verify that <sid> currently owns a fresh, valid lock.
# Checks: (1) ref exists, (2) blob decodes & validates, (3) holder == <sid>,
# (4) lease is fresh (elapsed < LOOM_LOCK_TTL).
# Returns:
#   0  — held and fresh
#   5  — absent, held by another session, or expired
#   10 — unreadable/corrupt lock blob
lock_verify_self() {
    local _sid="${1:-$SESSION_ID}" _sha _blob _h_sid _h_ts _now
    _sha=$(read_lock_sha)
    [ -n "$_sha" ] || return 5
    _blob=$(git -C "$REPO_ROOT" cat-file blob "$_sha" 2>/dev/null) || return 10
    _h_sid=$(printf '%s' "$_blob" | awk -F'\t' 'NR==1{print $1}')
    _h_ts=$(printf '%s' "$_blob" | awk -F'\t' 'NR==1{print $2}')
    [ -n "$_h_sid" ] || return 10
    _valid_identifier "$_h_sid" || return 10
    case "$_h_ts" in
    '' | *[!0-9]*) return 10 ;;
    esac
    [ "$_h_sid" = "$_sid" ] || return 5
    _now=$(now)
    case "$_now" in
    '' | *[!0-9]*) return 10 ;;
    esac
    [ $((_now - _h_ts)) -lt "$LOOM_LOCK_TTL" ] || return 5
    return 0
}

# lock_held_by_self — returns 0 iff $SESSION_ID holds a fresh lock
lock_held_by_self() {
    lock_verify_self "$SESSION_ID"
}

# lock_heartbeat [sid] — refresh the lock timestamp for <sid> via value-CAS if
# <sid> still owns a fresh lock. Returns 0 if ownership remains valid, 5/10 otherwise.
lock_heartbeat() {
    local _sid="${1:-$SESSION_ID}" _cur_sha _new_sha _rc
    lock_verify_self "$_sid"
    _rc=$?
    [ "$_rc" -eq 0 ] || return "$_rc"
    _cur_sha=$(read_lock_sha)
    [ -n "$_cur_sha" ] || return 5
    _new_sha=$(_make_blob_for "$_sid")
    [ -n "$_new_sha" ] || return 10
    if git -C "$REPO_ROOT" update-ref "$LOCK_REF" "$_new_sha" "$_cur_sha" 2>/dev/null; then
        return 0
    fi
    lock_verify_self "$_sid"
}

# lock_release_if_self [sid] — release refs/loom/lock ONLY if currently owned by <sid>.
# Never deletes a ref merely because a prior SHA was read; confirms current holder == <sid>
# before delete-CAS, retrying if the session's own renewer bumped the timestamp.
# Returns 0 on release, 5 if not held by <sid>.
lock_release_if_self() {
    local _sid="${1:-$SESSION_ID}" _cur_sha _h_sid
    _cur_sha=$(read_lock_sha)
    [ -n "$_cur_sha" ] || return 5
    _h_sid=$(decode_lock_field "$_cur_sha" 1)
    [ "$_h_sid" = "$_sid" ] || return 5
    while true; do
        if git -C "$REPO_ROOT" update-ref -d "$LOCK_REF" "$_cur_sha" 2>/dev/null; then
            return 0
        fi
        _cur_sha=$(read_lock_sha)
        if [ -z "$_cur_sha" ]; then
            return 0
        fi
        _h_sid=$(decode_lock_field "$_cur_sha" 1)
        if [ "$_h_sid" != "$_sid" ]; then
            return 5
        fi
    done
}

# slice_to_refname <slice> — map a slice name to a safe git ref path component.
# Uses git hash-object (SHA-1 of the slice bytes, no store) so the result always
# passes git check-ref-format regardless of the slice name (V5 fix: handles
# ".lock", "..", leading/trailing "."/"/", "@{", etc.) and is case-sensitive by
# construction (SHA-1 is byte-exact), solving case-fold collisions on APFS (V6).
# The original slice name is stored as field 3 of the claim blob.
slice_to_refname() {
    printf '%s' "$1" | git -C "$REPO_ROOT" hash-object --stdin 2>/dev/null
}

# claim_ref_for <slice> — full ref path for a slice claim
claim_ref_for() {
    printf '%s/%s' "$CLAIMS_REF_PREFIX" "$(slice_to_refname "$1")"
}

# _make_claim_blob_for <sid> <slice> — write {sid}\t{ts}\t{b64-slice}\n blob; print SHA or empty.
# Field 3 (slice) lets list-claims recover the original slice name from the hash-keyed ref.
# W2 fix: base64-encode the slice name so field 3 is always a single-line, tab/newline-safe
# token.  list-claims decodes it.  Fields 1 and 2 (sid, ts) are unaffected.
_make_claim_blob_for() {
    local _csid="$1" _cslice="$2" _cb64
    _cb64=$(printf '%s' "$_cslice" | base64 2>/dev/null | tr -d '\n')
    printf '%s\t%s\t%s\n' "$_csid" "$(now)" "$_cb64" |
        git -C "$REPO_ROOT" hash-object -w --stdin 2>/dev/null
}

# read_claim_sha <slice> — print current SHA of refs/loom/claims/<slice>, or empty
read_claim_sha() {
    local _ref
    _ref=$(claim_ref_for "$1")
    git -C "$REPO_ROOT" rev-parse --verify "$_ref" 2>/dev/null || true
}

# decode_claim_field <sha> <field-number> — read claim blob and print Nth tab field
decode_claim_field() {
    local _sha="$1" _field="$2"
    git -C "$REPO_ROOT" cat-file blob "$_sha" 2>/dev/null |
        awk -F'\t' -v f="$_field" '{print $f}'
}

# add_held_claim <slice>
add_held_claim() {
    _with_session_dir "$SESSION_ID" create _session_add_held_claim_op "$1"
}

# remove_held_claim <slice>
remove_held_claim() {
    _with_session_dir "$SESSION_ID" optional _session_remove_held_claim_op "$1"
}

# assert_session — exit 1 if SESSION_ID is empty
assert_session() {
    if [ -z "$SESSION_ID" ]; then
        printf 'loom-coord %s: --session <id> required (or LOOM_SESSION_ID)\n' "$SUBCOMMAND" >&2
        exit 1
    fi
    validate_session_id "$SESSION_ID"
}

# assert_lock_held — exit 5 if caller does not hold a fresh lock (10 on corrupt blob)
assert_lock_held() {
    lock_verify_self "$SESSION_ID"
    local _rc=$?
    if [ "$_rc" -eq 0 ]; then
        return 0
    elif [ "$_rc" -eq 10 ]; then
        printf 'loom-coord %s: corrupt lock state\n' "$SUBCOMMAND" >&2
        exit 10
    else
        printf 'loom-coord %s: precondition failed — lock not held by session %s\n' "$SUBCOMMAND" "$SESSION_ID" >&2
        exit 5
    fi
}

# ---------------------------------------------------------------------------
# Subcommand: lock-acquire
# ---------------------------------------------------------------------------
cmd_lock_acquire() {
    assert_session
    lock_acquire "$SESSION_ID"
    local _rc=$?
    case "$_rc" in
    0)
        printf 'acquired\n'
        exit 0
        ;;
    3)
        printf 'loom-coord lock-acquire: lock busy after %d retries\n' "$LOOM_LOCK_RETRIES" >&2
        exit 3
        ;;
    *)
        printf 'loom-coord lock-acquire: cannot create holder blob\n' >&2
        exit 10
        ;;
    esac
}

# ---------------------------------------------------------------------------
# Subcommand: lock-release
# ---------------------------------------------------------------------------
cmd_lock_release() {
    assert_session
    if ! lock_release_if_self "$SESSION_ID"; then
        printf 'loom-coord lock-release: lock not held by session %s\n' "$SESSION_ID" >&2
        exit 5
    fi
}

# ---------------------------------------------------------------------------
# Subcommand: lock-holder
# ---------------------------------------------------------------------------
cmd_lock_holder() {
    local _sha
    _sha=$(read_lock_sha)
    if [ -n "$_sha" ]; then
        git -C "$REPO_ROOT" cat-file blob "$_sha" 2>/dev/null || true
    fi
}

# ---------------------------------------------------------------------------
# Subcommand: lock-verify
# ---------------------------------------------------------------------------
cmd_lock_verify() {
    assert_session
    lock_verify_self "$SESSION_ID"
    local _rc=$?
    case "$_rc" in
    0)
        printf 'held\n'
        exit 0
        ;;
    10)
        printf 'loom-coord lock-verify: cannot read holder\n' >&2
        exit 10
        ;;
    *)
        printf 'loom-coord lock-verify: lock not held by %s\n' "$SESSION_ID" >&2
        exit 5
        ;;
    esac
}

# ---------------------------------------------------------------------------
# Subcommand: claim <slice>
# ---------------------------------------------------------------------------
cmd_claim() {
    assert_session
    assert_lock_held
    local slice="$EXTRA_ARGS"
    if [ -z "$slice" ]; then
        printf 'loom-coord claim: slice name required\n' >&2
        exit 1
    fi
    validate_slice_name "$slice"
    _with_session_dir "$SESSION_ID" optional _session_validate_held_op
    local _claim_state_rc=$?
    if [ "$_claim_state_rc" -ne 0 ] && [ "$_claim_state_rc" -ne 20 ]; then
        printf 'loom-coord claim: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi

    # Check-then-act under the held lock; CAS on the claim ref provides extra safety.
    local _ref cur_sha cur_sid cur_ts new_sha
    _ref=$(claim_ref_for "$slice")
    cur_sha=$(read_claim_sha "$slice")

    if [ -n "$cur_sha" ]; then
        cur_sid=$(decode_claim_field "$cur_sha" 1)
        cur_ts=$(decode_claim_field "$cur_sha" 2)

        if [ "$cur_sid" = "$SESSION_ID" ]; then
            # Own claim — idempotent re-affirm
            printf 'claimed %s %s %s\n' "$slice" "$SESSION_ID" "$cur_ts"
            exit 0
        fi

        # Another session's claim — liveness = lease freshness (ADR 0015)
        if claim_is_fresh "$cur_ts"; then
            printf 'loom-coord claim: slice %s has live claim by %s\n' "$slice" "$cur_sid" >&2
            exit 4
        fi

        # Stale claim — value-CAS steal from exact read SHA
        new_sha=$(_make_claim_blob_for "$SESSION_ID" "$slice")
        if [ -z "$new_sha" ]; then
            printf 'loom-coord claim: cannot create claim blob\n' >&2
            exit 10
        fi
        if ! git -C "$REPO_ROOT" update-ref "$_ref" "$new_sha" "$cur_sha" 2>/dev/null; then
            printf 'loom-coord claim: slice %s claimed by another session\n' "$slice" >&2
            exit 4
        fi
        if ! add_held_claim "$slice"; then
            printf 'loom-coord claim: unsafe session state for %s\n' "$SESSION_ID" >&2
            exit 10
        fi
        printf 'claimed %s %s %s\n' "$slice" "$SESSION_ID" "$(now)"
        exit 0
    fi

    # Absent — create-only CAS from null OID
    new_sha=$(_make_claim_blob_for "$SESSION_ID" "$slice")
    if [ -z "$new_sha" ]; then
        printf 'loom-coord claim: cannot create claim blob\n' >&2
        exit 10
    fi
    if ! git -C "$REPO_ROOT" update-ref "$_ref" "$new_sha" "$NULL_SHA" 2>/dev/null; then
        printf 'loom-coord claim: slice %s claimed by another session\n' "$slice" >&2
        exit 4
    fi
    if ! add_held_claim "$slice"; then
        printf 'loom-coord claim: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi
    printf 'claimed %s %s %s\n' "$slice" "$SESSION_ID" "$(now)"
    exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: renew <slice>
# No lock required — value-CAS on the per-slice ref is atomic.  The renewer
# calls this directly without acquiring the lock (ADR 0016 §2).
# ---------------------------------------------------------------------------
cmd_renew() {
    assert_session
    local slice="$EXTRA_ARGS"
    if [ -z "$slice" ]; then
        printf 'loom-coord renew: slice name required\n' >&2
        exit 1
    fi
    validate_slice_name "$slice"

    local _ref cur_sha cur_sid new_sha
    _ref=$(claim_ref_for "$slice")
    cur_sha=$(read_claim_sha "$slice")
    if [ -z "$cur_sha" ]; then
        printf 'loom-coord renew: no claim found for %s\n' "$slice" >&2
        exit 5
    fi
    cur_sid=$(decode_claim_field "$cur_sha" 1)
    if [ "$cur_sid" != "$SESSION_ID" ]; then
        printf 'loom-coord renew: slice %s not owned by %s\n' "$slice" "$SESSION_ID" >&2
        exit 5
    fi

    new_sha=$(_make_claim_blob_for "$SESSION_ID" "$slice")
    if [ -z "$new_sha" ]; then
        printf 'loom-coord renew: cannot create claim blob\n' >&2
        exit 10
    fi
    # Value-CAS on exact read SHA
    if ! git -C "$REPO_ROOT" update-ref "$_ref" "$new_sha" "$cur_sha" 2>/dev/null; then
        printf 'loom-coord renew: CAS failed for %s (concurrent update)\n' "$slice" >&2
        exit 5
    fi
    printf 'renewed %s %s\n' "$slice" "$(now)"
    exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: release-claim <slice>
# ---------------------------------------------------------------------------
cmd_release_claim() {
    assert_session
    assert_lock_held
    local slice="$EXTRA_ARGS"
    if [ -z "$slice" ]; then
        printf 'loom-coord release-claim: slice name required\n' >&2
        exit 1
    fi
    validate_slice_name "$slice"
    _with_session_dir "$SESSION_ID" optional _session_validate_held_op
    local _rc_preflight=$?
    case "$_rc_preflight" in
    0 | 20) ;;
    *)
        printf 'loom-coord release-claim: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
        ;;
    esac

    local _ref cur_sha cur_sid
    _ref=$(claim_ref_for "$slice")
    cur_sha=$(read_claim_sha "$slice")
    if [ -n "$cur_sha" ]; then
        cur_sid=$(decode_claim_field "$cur_sha" 1)
        if [ "$cur_sid" != "$SESSION_ID" ]; then
            printf 'loom-coord release-claim: slice %s not owned by %s\n' "$slice" "$SESSION_ID" >&2
            exit 5
        fi
        # Delete-CAS: only if ref still equals our blob SHA
        git -C "$REPO_ROOT" update-ref -d "$_ref" "$cur_sha" 2>/dev/null || true
    fi
    remove_held_claim "$slice"
    local _rc_remove=$?
    case "$_rc_remove" in
    0 | 20) ;;
    *)
        printf 'loom-coord release-claim: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
        ;;
    esac
    exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: reclaim <slice>
# ---------------------------------------------------------------------------
cmd_reclaim() {
    assert_session
    assert_lock_held
    local slice="$EXTRA_ARGS"
    if [ -z "$slice" ]; then
        printf 'loom-coord reclaim: slice name required\n' >&2
        exit 1
    fi
    validate_slice_name "$slice"
    _with_session_dir "$SESSION_ID" optional _session_validate_held_op
    local _reclaim_state_rc=$?
    if [ "$_reclaim_state_rc" -ne 0 ] && [ "$_reclaim_state_rc" -ne 20 ]; then
        printf 'loom-coord reclaim: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi

    local _ref cur_sha cur_sid cur_ts new_sha
    _ref=$(claim_ref_for "$slice")
    cur_sha=$(read_claim_sha "$slice")
    if [ -z "$cur_sha" ]; then
        printf 'loom-coord reclaim: no claim found for %s\n' "$slice" >&2
        exit 5
    fi
    cur_sid=$(decode_claim_field "$cur_sha" 1)
    cur_ts=$(decode_claim_field "$cur_sha" 2)

    if [ "$cur_sid" = "$SESSION_ID" ]; then
        printf 'loom-coord reclaim: already owner of %s\n' "$slice" >&2
        exit 5
    fi

    # Liveness = lease freshness (ADR 0015): a fresh lease means holder is alive.
    # Worktree-list membership and pid are NOT liveness signals.
    if claim_is_fresh "$cur_ts"; then
        printf 'loom-coord reclaim: holder %s of %s still has a fresh lease\n' "$cur_sid" "$slice" >&2
        exit 6
    fi

    # V3 fix: CAS steal FIRST; only destroy the orphan worktree after the CAS confirms
    # the old holder is provably stale and unchanged.  Never remove resources before
    # the CAS that authorises it — a holder that renewed in the TOCTOU window would
    # have its worktree destroyed even though the CAS would correctly refuse (V3).
    new_sha=$(_make_claim_blob_for "$SESSION_ID" "$slice")
    if [ -z "$new_sha" ]; then
        printf 'loom-coord reclaim: cannot create claim blob\n' >&2
        exit 10
    fi
    # Value-CAS steal from exact read SHA (ABA-safe)
    if ! git -C "$REPO_ROOT" update-ref "$_ref" "$new_sha" "$cur_sha" 2>/dev/null; then
        printf 'loom-coord reclaim: CAS failed for %s — holder renewed (still alive)\n' "$slice" >&2
        exit 4
    fi
    # CAS succeeded — orphan worktree cleanup is now safe
    git -C "$REPO_ROOT" worktree prune 2>/dev/null || true
    if _valid_identifier "$cur_sid"; then
        local wt_path
        wt_path=$(git -C "$REPO_ROOT" worktree list --porcelain 2>/dev/null | wt_sid_match "$cur_sid")
        if [ -n "$wt_path" ] && [ -d "$wt_path" ]; then
            git -C "$REPO_ROOT" worktree remove -f "$wt_path" 2>/dev/null || true
        fi
    fi
    if ! add_held_claim "$slice"; then
        printf 'loom-coord reclaim: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi
    printf 'reclaimed %s\n' "$slice"
    exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: list-claims
# ---------------------------------------------------------------------------
cmd_list_claims() {
    local refs_tmp
    refs_tmp=$(mktemp)
    git -C "$REPO_ROOT" for-each-ref \
        --format='%(refname) %(objectname)' \
        "$CLAIMS_REF_PREFIX/" 2>/dev/null >"$refs_tmp" || true
    while IFS=' ' read -r refname sha; do
        [ -z "$refname" ] && continue
        # W7 fix: read blob once; split fields with awk in one pass.
        local _blob _sid _ts _b64 _slice
        _blob=$(git -C "$REPO_ROOT" cat-file blob "$sha" 2>/dev/null)
        _sid=$(printf '%s' "$_blob" | awk -F'\t' 'NR==1{print $1}')
        _ts=$(printf '%s' "$_blob" | awk -F'\t' 'NR==1{print $2}')
        _b64=$(printf '%s' "$_blob" | awk -F'\t' 'NR==1{print $3}')
        [ -z "$_sid" ] && continue
        # W4 fix: base64-decode field 3 to recover the original slice name.
        # X7 fix: portable decode — try GNU (-d) then BSD (-D).
        # X5 fix: v1 claims may have plaintext in field 3 (no base64); decoding
        # them yields binary garbage.  Verify result is all-printable before
        # using it; fall back to the refname on empty or non-printable output.
        _slice=""
        if [ -n "$_b64" ]; then
            _decoded=$(printf '%s' "$_b64" | base64 -d 2>/dev/null) ||
                _decoded=$(printf '%s' "$_b64" | base64 -D 2>/dev/null) ||
                _decoded=""
            _clean=$(printf '%s' "${_decoded:-}" | tr -cd '[:print:]')
            if [ -n "$_clean" ] && [ "$_clean" = "$_decoded" ]; then
                _slice="$_clean"
            fi
        fi
        # Print: <original-slice-name or refname>\t<sid>\t<ts>
        if [ -n "$_slice" ]; then
            printf '%s\t%s\t%s\n' "$_slice" "$_sid" "$_ts"
        else
            printf '%s\t%s\t%s\n' "$refname" "$_sid" "$_ts"
        fi
    done <"$refs_tmp"
    rm -f "$refs_tmp"
}

# ---------------------------------------------------------------------------
# Subcommand: session-start
# ---------------------------------------------------------------------------
cmd_session_start() {
    # Mint uuid if --session not supplied
    if [ -z "$SESSION_ID" ]; then
        if command -v uuidgen >/dev/null 2>&1; then
            SESSION_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
        else
            SESSION_ID=$(od -An -N16 -tx1 /dev/urandom 2>/dev/null |
                tr -d ' \n' |
                sed 's/\(.\{8\}\)\(.\{4\}\)\(.\{4\}\)\(.\{4\}\)\(.\{12\}\)/\1-\2-\3-\4-\5/')
            if [ -z "$SESSION_ID" ]; then
                printf 'loom-coord session-start: cannot mint uuid\n' >&2
                exit 10
            fi
        fi
    fi

    validate_session_id "$SESSION_ID"
    if ! _with_session_dir "$SESSION_ID" create _session_init_op; then
        printf 'loom-coord session-start: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi
    printf '%s\n' "$SESSION_ID"
    exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: checkpoint-write
# ---------------------------------------------------------------------------
cmd_checkpoint_write() {
    assert_session
    _with_session_dir "$SESSION_ID" require _session_checkpoint_write_op
    local _rc=$?
    if [ "$_rc" -eq 20 ]; then
        printf 'loom-coord checkpoint-write: session %s not started\n' "$SESSION_ID" >&2
        exit 5
    fi
    if [ "$_rc" -ne 0 ]; then
        printf 'loom-coord checkpoint-write: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi
    exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: checkpoint-read
# ---------------------------------------------------------------------------
cmd_checkpoint_read() {
    assert_session
    _with_session_dir "$SESSION_ID" optional _session_checkpoint_read_op
    local _rc=$?
    case "$_rc" in
    0 | 20 | 21) exit 0 ;;
    *)
        printf 'loom-coord checkpoint-read: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
        ;;
    esac
}

# ---------------------------------------------------------------------------
# Subcommand: session-bootstrap (cold-restart re-adoption, self-locking)
# ---------------------------------------------------------------------------
cmd_session_bootstrap() {
    assert_session
    local _sb_claims
    _sb_claims=$(mktemp) || exit 10
    _with_session_dir "$SESSION_ID" require _session_copy_held_claims_op "$_sb_claims"
    local _sb_state_rc=$?
    if [ "$_sb_state_rc" -eq 20 ]; then
        rm -f "$_sb_claims"
        printf 'loom-coord session-bootstrap: session %s not found\n' "$SESSION_ID" >&2
        exit 5
    fi
    if [ "$_sb_state_rc" -eq 21 ]; then
        : >"$_sb_claims"
    elif [ "$_sb_state_rc" -ne 0 ]; then
        rm -f "$_sb_claims"
        printf 'loom-coord session-bootstrap: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi

    # Acquire lock to renew claims via centralized lock_acquire
    if ! lock_acquire "$SESSION_ID"; then
        local _sb_lock_rc=$?
        rm -f "$_sb_claims"
        if [ "$_sb_lock_rc" -eq 3 ]; then
            printf 'loom-coord session-bootstrap: could not acquire lock\n' >&2
            exit 3
        fi
        printf 'loom-coord session-bootstrap: cannot create holder blob\n' >&2
        exit 10
    fi

    # Renew each held claim via value-CAS on the claim ref (verifying lock ownership before each mutation)
    local _sb_hb_rc=0
    while IFS= read -r slice; do
        [ -z "$slice" ] && continue
        _valid_slice_name "$slice" || continue
        if ! lock_heartbeat "$SESSION_ID"; then
            _sb_hb_rc=$?
            break
        fi
        local _ref cur_sha cur_sid new_sha
        _ref=$(claim_ref_for "$slice")
        cur_sha=$(read_claim_sha "$slice")
        if [ -n "$cur_sha" ]; then
            cur_sid=$(decode_claim_field "$cur_sha" 1)
            if [ "$cur_sid" = "$SESSION_ID" ]; then
                new_sha=$(_make_claim_blob_for "$SESSION_ID" "$slice")
                if [ -n "$new_sha" ] &&
                    git -C "$REPO_ROOT" update-ref "$_ref" "$new_sha" "$cur_sha" 2>/dev/null; then
                    printf 'renewed %s %s\n' "$slice" "$(now)"
                fi
            fi
        fi
    done <"$_sb_claims"
    rm -f "$_sb_claims"
    if [ "$_sb_hb_rc" -ne 0 ]; then
        printf 'loom-coord session-bootstrap: lock ownership lost during bootstrap\n' >&2
        [ "$_sb_hb_rc" -eq 10 ] && exit 10
        exit 5
    fi

    # Release lock only if still held by self
    if ! lock_release_if_self "$SESSION_ID"; then
        printf 'loom-coord session-bootstrap: lock ownership lost before release\n' >&2
        exit 5
    fi

    # Print checkpoint through a fresh boundary check.
    local _sb_checkpoint
    _sb_checkpoint=$(_with_session_dir "$SESSION_ID" require _session_checkpoint_read_op)
    local _sb_checkpoint_rc=$?
    if [ "$_sb_checkpoint_rc" -eq 0 ]; then
        printf 'checkpoint: '
        printf '%s\n' "$_sb_checkpoint"
    elif [ "$_sb_checkpoint_rc" -ne 21 ]; then
        printf 'loom-coord session-bootstrap: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi
    exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: session-end
# ---------------------------------------------------------------------------
cmd_session_end() {
    assert_session
    local _se_claims
    _se_claims=$(mktemp) || exit 10
    _with_session_dir "$SESSION_ID" optional _session_copy_held_claims_op "$_se_claims"
    local _se_state_rc=$?
    case "$_se_state_rc" in
    0) ;;
    20 | 21) : >"$_se_claims" ;;
    *)
        rm -f "$_se_claims"
        printf 'loom-coord session-end: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
        ;;
    esac

    # Release any still-held claims (self-locking).
    # IMPORTANT: do NOT remove the session dir when lock acquisition or ownership fails —
    # that would orphan claim registry rows (no held-claims backref -> permanent double-grant risk).
    if [ -s "$_se_claims" ]; then
        if lock_acquire "$SESSION_ID"; then
            local _se_hb_rc=0
            while IFS= read -r slice; do
                [ -z "$slice" ] && continue
                _valid_slice_name "$slice" || continue
                if ! lock_heartbeat "$SESSION_ID"; then
                    _se_hb_rc=$?
                    break
                fi
                local _ref cur_sha cur_sid
                _ref=$(claim_ref_for "$slice")
                cur_sha=$(read_claim_sha "$slice")
                if [ -n "$cur_sha" ]; then
                    cur_sid=$(decode_claim_field "$cur_sha" 1)
                    if [ "$cur_sid" = "$SESSION_ID" ]; then
                        git -C "$REPO_ROOT" update-ref -d "$_ref" "$cur_sha" 2>/dev/null || true
                    fi
                fi
            done <"$_se_claims"
            if [ "$_se_hb_rc" -ne 0 ]; then
                rm -f "$_se_claims"
                printf 'loom-coord session-end: lock ownership lost; claims not fully released\n' >&2
                [ "$_se_hb_rc" -eq 10 ] && exit 10
                exit 5
            fi
            if ! lock_release_if_self "$SESSION_ID"; then
                rm -f "$_se_claims"
                printf 'loom-coord session-end: lock ownership lost before release\n' >&2
                exit 5
            fi
            if ! _remove_session_dir "$SESSION_ID"; then
                rm -f "$_se_claims"
                printf 'loom-coord session-end: unsafe session state for %s\n' "$SESSION_ID" >&2
                exit 10
            fi
        else
            local _se_lock_rc=$?
            rm -f "$_se_claims"
            if [ "$_se_lock_rc" -eq 3 ]; then
                printf 'loom-coord session-end: could not acquire lock; claims not released\n' >&2
                exit 3
            fi
            printf 'loom-coord session-end: cannot create holder blob\n' >&2
            exit 10
        fi
    else
        # No held-claims file — safe to remove the session dir directly
        _remove_session_dir "$SESSION_ID"
        local _se_remove_rc=$?
        case "$_se_remove_rc" in
        0 | 20) ;;
        *)
            rm -f "$_se_claims"
            printf 'loom-coord session-end: unsafe session state for %s\n' "$SESSION_ID" >&2
            exit 10
            ;;
        esac
    fi
    rm -f "$_se_claims"
    exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: cleanup (self-locking sweep)
# ---------------------------------------------------------------------------
cmd_cleanup() {
    if ! (_state_dir_enter create); then
        printf 'loom-coord cleanup: unsafe state root\n' >&2
        exit 10
    fi

    if [ -n "$SESSION_ID" ]; then
        validate_session_id "$SESSION_ID"
    fi

    # Prune stale worktree refs
    git -C "$REPO_ROOT" worktree prune 2>/dev/null || true

    local cleanup_sid="${SESSION_ID:-cleanup-$$}"
    if ! lock_acquire "$cleanup_sid"; then
        local _cl_lock_rc=$?
        if [ "$_cl_lock_rc" -eq 3 ]; then
            printf 'loom-coord cleanup: could not acquire lock; claims sweep skipped\n' >&2
            exit 3
        fi
        printf 'loom-coord cleanup: cannot create holder blob\n' >&2
        exit 10
    fi

    # Optional test-only delay hook for forced-race ownership tests
    if [ -n "${LOOM_COORD_TEST_CLEANUP_SLEEP:-}" ]; then
        sleep "$LOOM_COORD_TEST_CLEANUP_SLEEP" 2>/dev/null || true
    fi

    local swept=0
    local skipped=0

    # Verify ownership before snapshotting/sweeping claims
    if ! lock_verify_self "$cleanup_sid"; then
        local _cl_pre_rc=$?
        printf 'loom-coord cleanup: lock ownership lost before sweep\n' >&2
        [ "$_cl_pre_rc" -eq 10 ] && exit 10
        exit 5
    fi

    local refs_tmp
    refs_tmp=$(mktemp)
    git -C "$REPO_ROOT" for-each-ref \
        --format='%(refname) %(objectname)' \
        "$CLAIMS_REF_PREFIX/" 2>/dev/null >"$refs_tmp" || true

    # Hoist worktree list once for the entire sweep (orphan-removal lookups only)
    local wt_list
    wt_list=$(git -C "$REPO_ROOT" worktree list --porcelain 2>/dev/null)

    local _cl_hb_rc=0
    while IFS=' ' read -r refname sha; do
        [ -z "$refname" ] && continue
        if ! lock_heartbeat "$cleanup_sid"; then
            _cl_hb_rc=$?
            break
        fi
        local sid ts
        sid=$(git -C "$REPO_ROOT" cat-file blob "$sha" 2>/dev/null |
            awk -F'\t' '{print $1}')
        ts=$(git -C "$REPO_ROOT" cat-file blob "$sha" 2>/dev/null |
            awk -F'\t' '{print $2}')

        # R7: empty-sid or non-numeric ts → preserve fail-closed, count as skipped
        case "$ts" in
        '' | *[!0-9]*)
            skipped=$((skipped + 1))
            continue
            ;;
        esac
        if [ -z "$sid" ]; then
            skipped=$((skipped + 1))
            continue
        fi
        if ! _valid_identifier "$sid"; then
            skipped=$((skipped + 1))
            continue
        fi

        # Liveness = lease freshness (ADR 0015)
        if claim_is_fresh "$ts"; then
            skipped=$((skipped + 1))
        else
            # V2 fix: delete-CAS FIRST; destroy resources only after the CAS
            # confirms the claim was stale and unchanged.
            if git -C "$REPO_ROOT" update-ref -d "$refname" "$sha" 2>/dev/null; then
                local wt_path
                wt_path=$(printf '%s\n' "$wt_list" | wt_sid_match "$sid")
                if [ -n "$wt_path" ] && [ -d "$wt_path" ]; then
                    git -C "$REPO_ROOT" worktree remove -f "$wt_path" 2>/dev/null || true
                fi
                _remove_session_dir "$sid"
                swept=$((swept + 1))
            else
                skipped=$((skipped + 1))
            fi
        fi
    done <"$refs_tmp"
    rm -f "$refs_tmp"
    if [ "$_cl_hb_rc" -ne 0 ]; then
        printf 'loom-coord cleanup: lock ownership lost during sweep\n' >&2
        [ "$_cl_hb_rc" -eq 10 ] && exit 10
        exit 5
    fi

    if ! lock_release_if_self "$cleanup_sid"; then
        printf 'loom-coord cleanup: lock ownership lost before release\n' >&2
        exit 5
    fi

    printf 'swept %d dead claims; skipped %d live claims\n' "$swept" "$skipped"
    exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: renewer-start <session-pid>
# ---------------------------------------------------------------------------
cmd_renewer_start() {
    assert_session
    _with_session_dir "$SESSION_ID" require _session_validate_held_op
    local _rs_state_rc=$?
    if [ "$_rs_state_rc" -eq 20 ]; then
        printf 'loom-coord renewer-start: session %s not found\n' "$SESSION_ID" >&2
        exit 5
    fi
    if [ "$_rs_state_rc" -ne 0 ]; then
        printf 'loom-coord renewer-start: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi

    local spid="$EXTRA_ARGS"
    if [ -z "$spid" ]; then
        printf 'loom-coord renewer-start: <session-pid> required\n' >&2
        exit 1
    fi
    validate_pid "$spid"

    # Capture reuse-robust identity of the stable session process (ADR 0015 §2)
    local sst
    sst=$(process_starttime "$spid")
    if [ -z "$sst" ]; then
        printf 'loom-coord renewer-start: cannot read start-time for pid %s\n' "$spid" >&2
        exit 10
    fi
    if ! _with_session_dir "$SESSION_ID" require \
        _session_write_process_state_op session "$spid" "$sst"; then
        printf 'loom-coord renewer-start: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi

    # Check-then-launch: do not start a second renewer (duplicate suppression)
    if _renewer_alive "$SESSION_ID"; then
        printf 'renewer-already-running\n'
        exit 0
    fi

    # Resolve absolute path to this script for the renewer's lock-acquire callbacks
    local _coord
    _coord="$(cd "$(dirname -- "$0")" 2>/dev/null && pwd)/$(basename -- "$0")"

    # Capture locals needed inside the detached subshell
    local _sid="$SESSION_ID"
    local _interval="$LOOM_RENEW_INTERVAL"
    local _lock_interval="$LOOM_LOCK_RENEW_INTERVAL"
    local _root="$REPO_ROOT"

    # Launch detached background renewer.  Uses _session_alive (inherited function)
    # with the reuse-robust identity gate: exits when session pid dies or start-time
    # changes (recycled pid).
    #
    # V1 fix — two cadences, decoupled:
    #   Lock heartbeat:  every _lock_interval (~LOOM_LOCK_TTL/3, default 10s).
    #                    Keeps refs/loom/lock alive across long critical sections.
    #   Claim heartbeat: every LOOM_RENEW_INTERVAL (default 1200s).
    #                    Claims have a much longer TTL (3600s); infrequent renewal OK.
    # The loop sleeps _lock_interval per tick; claims are renewed every
    # (_interval/_lock_interval) ticks.
    #
    # stdin/stdout/stderr are closed (redirected to /dev/null) so the subshell does
    # not hold inherited file descriptors open — prevents callers that capture output
    # (e.g. bats `run`) from hanging.
    (
        cd "$_root" 2>/dev/null || exit 1
        _tick=0
        _lease_every=$((_interval / _lock_interval))
        [ "$_lease_every" -lt 1 ] && _lease_every=1
        while _session_alive "$_sid"; do
            sleep "$_lock_interval" 2>/dev/null || true
            _tick=$((_tick + 1))

            # Lock heartbeat every tick (fast cadence — must stay below LOOM_LOCK_TTL)
            _lsha=$(git -C "$_root" rev-parse --verify "refs/loom/lock" 2>/dev/null || true)
            if [ -n "$_lsha" ]; then
                _lsid=$(git -C "$_root" cat-file blob "$_lsha" 2>/dev/null |
                    awk -F'\t' '{print $1}')
                if [ "$_lsid" = "$_sid" ]; then
                    _nlsha=$(printf '%s\t%s\t%s\t\n' "$_sid" "$(date +%s)" "$$" |
                        git -C "$_root" hash-object -w --stdin 2>/dev/null || true)
                    if [ -n "$_nlsha" ]; then
                        git -C "$_root" update-ref \
                            "refs/loom/lock" "$_nlsha" "$_lsha" 2>/dev/null || true
                    fi
                fi
            fi

            # Claim heartbeat every _lease_every ticks (slow cadence — claims have long TTL)
            if [ $((_tick % _lease_every)) -eq 0 ]; then
                _claims_tmp=$(mktemp 2>/dev/null || true)
                if [ -n "$_claims_tmp" ] &&
                    _with_session_dir "$_sid" require \
                        _session_copy_held_claims_op "$_claims_tmp"; then
                    while IFS= read -r _s; do
                        [ -z "$_s" ] && continue
                        sh "$_coord" renew "$_s" --session "$_sid" >/dev/null 2>&1 || true
                    done <"$_claims_tmp"
                fi
                [ -z "$_claims_tmp" ] || rm -f "$_claims_tmp"
            fi
        done
    ) </dev/null >/dev/null 2>&1 &
    local rpid=$!
    local rst
    rst=$(process_starttime "$rpid")
    if ! _with_session_dir "$SESSION_ID" require \
        _session_write_process_state_op renewer "$rpid" "$rst"; then
        kill "$rpid" 2>/dev/null || true
        wait "$rpid" 2>/dev/null || true
        printf 'loom-coord renewer-start: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi
    printf 'renewer-started pid=%s\n' "$rpid"
    exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: renewer-stop
# ---------------------------------------------------------------------------
cmd_renewer_stop() {
    assert_session
    local _renewer_state
    _renewer_state=$(mktemp) || exit 10
    _with_session_dir "$SESSION_ID" require \
        _session_read_process_state_op renewer >"$_renewer_state"
    local _rt_state_rc=$?
    if [ "$_rt_state_rc" -eq 20 ]; then
        rm -f "$_renewer_state"
        printf 'loom-coord renewer-stop: session %s not found\n' "$SESSION_ID" >&2
        exit 5
    fi
    if [ "$_rt_state_rc" -eq 21 ]; then
        rm -f "$_renewer_state"
        printf 'no-renewer\n'
        exit 0
    fi
    if [ "$_rt_state_rc" -ne 0 ]; then
        rm -f "$_renewer_state"
        printf 'loom-coord renewer-stop: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi

    local rpid rst cur_st
    rpid=$(sed -n '1p' "$_renewer_state")
    if [ -z "$rpid" ]; then
        rm -f "$_renewer_state"
        printf 'no-renewer\n'
        exit 0
    fi
    rst=$(sed -n '2p' "$_renewer_state")
    rm -f "$_renewer_state"

    # Identity gate (U5): only kill if start-time is known AND matches the live pid.
    # Empty rst means process_starttime failed at renewer-start time; we cannot
    # confirm identity → do NOT kill (the pid may have been recycled by an unrelated
    # process since the renewer died).
    if kill -0 "$rpid" 2>/dev/null; then
        if [ -n "$rst" ]; then
            cur_st=$(process_starttime "$rpid")
            if [ "$cur_st" = "$rst" ]; then
                kill "$rpid" 2>/dev/null || true
            fi
        fi
    fi
    if ! _with_session_dir "$SESSION_ID" require _session_remove_renewer_state_op; then
        printf 'loom-coord renewer-stop: unsafe session state for %s\n' "$SESSION_ID" >&2
        exit 10
    fi
    printf 'renewer-stopped\n'
    exit 0
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
# X4 fix: schema gate runs ONLY on acquire/claim paths.  Teardown/recovery
# subcommands (lock-release, release-claim, cleanup, session-end) must always
# run regardless of schema state — gating them on schema wedges recovery when
# refs/loom/schema is corrupt or holds an unknown version.
case "$SUBCOMMAND" in
lock-acquire | claim | renew) _check_or_set_schema ;;
esac

case "$SUBCOMMAND" in
lock-acquire) cmd_lock_acquire ;;
lock-release) cmd_lock_release ;;
lock-holder) cmd_lock_holder ;;
lock-verify) cmd_lock_verify ;;
claim) cmd_claim ;;
renew) cmd_renew ;;
release-claim) cmd_release_claim ;;
reclaim) cmd_reclaim ;;
list-claims) cmd_list_claims ;;
session-start) cmd_session_start ;;
checkpoint-write) cmd_checkpoint_write ;;
checkpoint-read) cmd_checkpoint_read ;;
session-bootstrap) cmd_session_bootstrap ;;
session-end) cmd_session_end ;;
cleanup) cmd_cleanup ;;
renewer-start) cmd_renewer_start ;;
renewer-stop) cmd_renewer_stop ;;
*)
    printf 'loom-coord: unknown subcommand: %s\n' "$SUBCOMMAND" >&2
    exit 1
    ;;
esac

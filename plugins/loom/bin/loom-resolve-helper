#!/usr/bin/env bash
# loom-resolve-helper — installed-root helper bootstrap
# (spec 10 → Installed-root and helper binding; ADR 0018 shared-core/thin-adapter).
#
# Resolves and validates ONE of the two versioned root bindings
#   plugins/loom/adapters/roots/claude-plugin-root-v1.json
#   plugins/loom/adapters/roots/codex-skill-source-v1.json
# and prints the absolute, validated path of an allowlisted helper below that
# root's bin/. It never executes the resolved helper — callers invoke the
# printed absolute path themselves.
#
# Usage:
#   loom-resolve-helper claude <helper>
#       Resolves via the client-injected CLAUDE_PLUGIN_ROOT: must be absolute,
#       canonicalize to a physical directory whose .claude-plugin/plugin.json
#       names "loom" 0.2.0.
#   loom-resolve-helper codex <absolute-skill-source-path> <helper>
#       Resolves via the absolute source path of a loaded skills/<skill>/SKILL.md
#       file: resolves the physical skill directory, ascends "../.." to the
#       plugin root, and validates .codex-plugin/plugin.json names "loom" 0.2.0.
#       Never reads CLAUDE_PLUGIN_ROOT, PLUGIN_ROOT, CODEX_HOME, or PATH.
#
# FAIL DIRECTION: fail-closed. Any parse/identity/containment ambiguity denies —
# never prints a helper path it cannot prove is safe.
#
# Exit codes:
#   0 — success; the validated absolute helper path is on stdout, nothing on stderr
#   1 — usage error (bad argument count/shape)
#   2 — fail-closed: a resolution/identity/containment check failed
set -u

EXPECTED_NAME="loom"
EXPECTED_VERSION="0.2.0"
ALLOWED_HELPERS=(loom-coord)

_usage() {
    printf 'usage: loom-resolve-helper claude <helper>\n' >&2
    printf '       loom-resolve-helper codex <absolute-skill-source-path> <helper>\n' >&2
    printf '       loom-resolve-helper antigravity <absolute-skill-source-path> <helper>\n' >&2
    exit 1
}

_fail() {
    printf 'loom-resolve-helper: %s\n' "$1" >&2
    exit 2
}

_is_allowed_helper() {
    local name="$1" candidate
    for candidate in "${ALLOWED_HELPERS[@]}"; do
        [ "$candidate" = "$name" ] && return 0
    done
    return 1
}

# _canon_dir <path> — canonicalize an existing directory; prints its absolute
# physical path (symlinks in the directory chain resolved by cd -P).
_canon_dir() {
    CDPATH='' cd -- "$1" 2>/dev/null && pwd -P
}

# _canon_path <path> — canonicalize an existing file or directory, resolving
# any symlink chain without relying on GNU-only realpath -f.
_canon_path() {
    local target="$1" dir base resolved link i=0
    if [ -d "$target" ]; then
        _canon_dir "$target"
        return $?
    fi
    { [ -e "$target" ] || [ -L "$target" ]; } || return 1
    dir=$(dirname -- "$target")
    base=$(basename -- "$target")
    dir=$(_canon_dir "$dir") || return 1
    resolved="$dir/$base"
    while [ -L "$resolved" ]; do
        i=$((i + 1))
        [ "$i" -gt 40 ] && return 1
        link=$(readlink -- "$resolved") || return 1
        case "$link" in
        /*) resolved="$link" ;;
        *) resolved="$(dirname -- "$resolved")/$link" ;;
        esac
        dir=$(dirname -- "$resolved")
        base=$(basename -- "$resolved")
        dir=$(_canon_dir "$dir") || return 1
        resolved="$dir/$base"
    done
    printf '%s\n' "$resolved"
}

# _require_contained <canonical-child> <canonical-root> — child must be
# strictly below root (rejects symlink escape via any intermediate segment).
_require_contained() {
    case "$1" in
    "$2"/*) return 0 ;;
    *) return 1 ;;
    esac
}

# _frontmatter_name <file> — print the leading-frontmatter "name:" value.
_frontmatter_name() {
    local file="$1" in_fm=0 line name=""
    while IFS= read -r line || [ -n "$line" ]; do
        if [ "$in_fm" -eq 0 ]; then
            if [ "$line" = "---" ]; then
                in_fm=1
                continue
            fi
            return 1
        fi
        if [ "$line" = "---" ]; then
            break
        fi
        case "$line" in
        name:\ *) name="${line#name: }" ;;
        name:*) name="${line#name:}" ;;
        esac
    done <"$file"
    [ -n "$name" ] || return 1
    printf '%s\n' "$name"
}

# _validate_manifest <canonical-root> <manifest-relative-path>
_validate_manifest() {
    local root="$1" relpath="$2" manifest_path canon_manifest name version
    manifest_path="$root/$relpath"
    { [ -e "$manifest_path" ] || [ -L "$manifest_path" ]; } || _fail "manifest not found: $relpath"
    canon_manifest=$(_canon_path "$manifest_path") || _fail "manifest cannot be canonicalized: $relpath"
    _require_contained "$canon_manifest" "$root" || _fail "manifest escapes plugin root: $relpath"
    [ -f "$canon_manifest" ] || _fail "manifest is not a regular file: $relpath"
    name=$(jq -r '.name // empty' "$canon_manifest" 2>/dev/null) || _fail "manifest is not valid JSON: $relpath"
    version=$(jq -r '.version // empty' "$canon_manifest" 2>/dev/null) || _fail "manifest is not valid JSON: $relpath"
    [ "$name" = "$EXPECTED_NAME" ] || _fail "manifest name mismatch: $relpath"
    [ "$version" = "$EXPECTED_VERSION" ] || _fail "manifest version mismatch: $relpath"
}

# _resolve_helper_path <canonical-root> <helper-name> — prints canonical helper path
_resolve_helper_path() {
    local root="$1" helper="$2" canon_bin helper_path canon_helper
    _is_allowed_helper "$helper" || _fail "helper not allowlisted: $helper"
    [ -d "$root/bin" ] || _fail "helper directory missing"
    canon_bin=$(_canon_dir "$root/bin") || _fail "helper directory cannot be canonicalized"
    _require_contained "$canon_bin" "$root" || _fail "helper directory escapes plugin root"
    helper_path="$root/bin/$helper"
    { [ -e "$helper_path" ] || [ -L "$helper_path" ]; } || _fail "helper not found: $helper"
    canon_helper=$(_canon_path "$helper_path") || _fail "helper cannot be canonicalized: $helper"
    [ "$(dirname -- "$canon_helper")" = "$canon_bin" ] || _fail "helper is not a direct child of bin/: $helper"
    _require_contained "$canon_helper" "$root" || _fail "helper escapes plugin root: $helper"
    [ -f "$canon_helper" ] || _fail "helper is not a regular file: $helper"
    [ -x "$canon_helper" ] || _fail "helper is not executable: $helper"
    printf '%s\n' "$canon_helper"
}

_resolve_claude() {
    local helper="$1" input root
    input="${CLAUDE_PLUGIN_ROOT:-}"
    [ -n "$input" ] || _fail "CLAUDE_PLUGIN_ROOT is empty or unset"
    case "$input" in
    /*) ;;
    *) _fail "CLAUDE_PLUGIN_ROOT is not absolute" ;;
    esac
    [ -d "$input" ] || _fail "CLAUDE_PLUGIN_ROOT is not a directory"
    root=$(_canon_dir "$input") || _fail "CLAUDE_PLUGIN_ROOT cannot be canonicalized"
    _validate_manifest "$root" ".claude-plugin/plugin.json"
    _resolve_helper_path "$root" "$helper"
}

_resolve_codex() {
    local source="$1" helper="$2"
    local after_skills skill_name canon_skill skill_dir canon_skill_dirname
    local fm_name root_candidate root expected_skill canon_expected_skill
    case "$source" in
    /*) ;;
    *) _fail "skill source path is not absolute" ;;
    esac
    case "$source" in
    */skills/*/SKILL.md) ;;
    *) _fail "skill source path does not end in skills/<skill>/SKILL.md" ;;
    esac
    after_skills="${source##*/skills/}"
    skill_name="${after_skills%/SKILL.md}"
    case "$skill_name" in
    '' | */*) _fail "skill source path has a malformed skill segment" ;;
    esac
    { [ -e "$source" ] || [ -L "$source" ]; } || _fail "skill source path does not exist"
    canon_skill=$(_canon_path "$source") || _fail "skill source cannot be canonicalized"
    [ -f "$canon_skill" ] || _fail "skill source is not a regular file"
    skill_dir=$(dirname -- "$canon_skill")
    canon_skill_dirname=$(basename -- "$skill_dir")
    [ "$canon_skill_dirname" = "$skill_name" ] || _fail "skill directory identity mismatch after canonicalization"
    fm_name=$(_frontmatter_name "$canon_skill") || _fail "skill frontmatter has no name"
    [ "$fm_name" = "$skill_name" ] || _fail "skill frontmatter name does not match directory"
    root_candidate=$(dirname -- "$(dirname -- "$skill_dir")")
    [ -d "$root_candidate" ] || _fail "plugin root candidate is not a directory"
    root=$(_canon_dir "$root_candidate") || _fail "plugin root cannot be canonicalized"
    expected_skill="$root/skills/$skill_name/SKILL.md"
    { [ -e "$expected_skill" ] || [ -L "$expected_skill" ]; } || _fail "resolved root does not contain the selected skill"
    canon_expected_skill=$(_canon_path "$expected_skill") || _fail "resolved skill path cannot be canonicalized"
    [ "$canon_expected_skill" = "$canon_skill" ] || _fail "resolved root does not physically contain the selected skill"
    _validate_manifest "$root" ".codex-plugin/plugin.json"
    _resolve_helper_path "$root" "$helper"
}

_resolve_antigravity() {
    local source="$1" helper="$2"
    local after_skills skill_name canon_skill skill_dir canon_skill_dirname
    local fm_name parent_root root repo_root expected_skill canon_expected_skill
    case "$source" in
    /*) ;;
    *) _fail "skill source path is not absolute" ;;
    esac
    case "$source" in
    */skills/*/SKILL.md) ;;
    *) _fail "skill source path does not end in skills/<skill>/SKILL.md" ;;
    esac
    after_skills="${source##*/skills/}"
    skill_name="${after_skills%/SKILL.md}"
    case "$skill_name" in
    '' | */*) _fail "skill source path has a malformed skill segment" ;;
    esac
    { [ -e "$source" ] || [ -L "$source" ]; } || _fail "skill source path does not exist"
    canon_skill=$(_canon_path "$source") || _fail "skill source cannot be canonicalized"
    [ -f "$canon_skill" ] || _fail "skill source is not a regular file"
    skill_dir=$(dirname -- "$canon_skill")
    canon_skill_dirname=$(basename -- "$skill_dir")
    [ "$canon_skill_dirname" = "$skill_name" ] || _fail "skill directory identity mismatch after canonicalization"
    fm_name=$(_frontmatter_name "$canon_skill") || _fail "skill frontmatter has no name"
    [ "$fm_name" = "$skill_name" ] || _fail "skill frontmatter name does not match directory"
    parent_root=$(dirname -- "$(dirname -- "$skill_dir")")
    [ -d "$parent_root" ] || _fail "skill container root is not a directory"
    parent_root=$(_canon_dir "$parent_root") || _fail "skill container root cannot be canonicalized"
    if [ "$(basename -- "$parent_root")" = ".agents" ]; then
        repo_root=$(_canon_dir "$(dirname -- "$parent_root")") || _fail "repository root cannot be canonicalized"
        [ -d "$repo_root/plugins/loom" ] || _fail "plugin root candidate is not a directory"
        root=$(_canon_dir "$repo_root/plugins/loom") || _fail "plugin root cannot be canonicalized"
        _require_contained "$canon_skill" "$repo_root/.agents" || _fail "skill source escapes .agents root"
    else
        root="$parent_root"
    fi
    expected_skill="$root/skills/$skill_name/SKILL.md"
    { [ -e "$expected_skill" ] || [ -L "$expected_skill" ]; } || _fail "resolved root does not contain the selected skill"
    canon_expected_skill=$(_canon_path "$expected_skill") || _fail "resolved skill path cannot be canonicalized"
    _require_contained "$canon_expected_skill" "$root" || _fail "resolved skill escapes plugin root"
    _validate_manifest "$root" ".codex-plugin/plugin.json"
    _validate_manifest "$root" ".claude-plugin/plugin.json"
    _resolve_helper_path "$root" "$helper"
}

main() {
    local mode="${1:-}"
    case "$mode" in
    claude)
        [ "$#" -eq 2 ] || _usage
        _resolve_claude "$2"
        ;;
    codex)
        [ "$#" -eq 3 ] || _usage
        _resolve_codex "$2" "$3"
        ;;
    antigravity)
        [ "$#" -eq 3 ] || _usage
        _resolve_antigravity "$2" "$3"
        ;;
    *)
        _usage
        ;;
    esac
}

main "$@"

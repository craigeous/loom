{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/craigeous/loom/schemas/loom-eval-gate-rerun-v1.schema.json",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "sha256"],
      "properties": {
        "file_count": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "run_id", "manifest_sha256", "seq", "command_env_sha256", "tool_versions",
    "started_at", "ended_at", "completion", "exit_status", "stdout", "stderr",
    "start_inventory", "end_inventory", "changes", "source_verification", "result"
  ],
  "properties": {
    "protocol": { "const": "loom-eval-gate-rerun/v1" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "seq": { "type": "integer", "minimum": 1 },
    "command_env_sha256": { "$ref": "#/$defs/sha256" },
    "tool_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "started_at": { "$ref": "#/$defs/utc" },
    "ended_at": { "$ref": "#/$defs/utc" },
    "completion": { "enum": ["completed", "interrupted", "blocked", "invalid"] },
    "exit_status": { "type": ["integer", "null"] },
    "stdout": { "$ref": "#/$defs/stream" },
    "stderr": { "$ref": "#/$defs/stream" },
    "start_inventory": { "$ref": "#/$defs/inventory" },
    "end_inventory": { "$ref": "#/$defs/inventory" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["added", "modified", "deleted"] }
        }
      }
    },
    "source_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "checkout"],
      "properties": {
        "source": { "enum": ["unchanged", "changed"] },
        "checkout": { "enum": ["unchanged", "changed"] }
      }
    },
    "result": { "enum": ["rerun-passed", "rerun-failed", "infrastructure-blocked", "invalid"] }
  },
  "allOf": [
    {
      "if": { "properties": { "completion": { "const": "completed" } } },
      "then": { "properties": { "exit_status": { "type": "integer" } } },
      "else": { "properties": { "exit_status": { "type": "null" } } }
    },
    {
      "if": { "properties": { "result": { "const": "rerun-passed" } } },
      "then": {
        "properties": {
          "completion": { "const": "completed" },
          "exit_status": { "const": 0 },
          "source_verification": {
            "type": "object",
            "properties": { "source": { "const": "unchanged" }, "checkout": { "const": "unchanged" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "result": { "const": "rerun-failed" } } },
      "then": {
        "properties": {
          "completion": { "const": "completed" },
          "exit_status": { "type": "integer", "not": { "const": 0 } },
          "source_verification": {
            "type": "object",
            "properties": { "source": { "const": "unchanged" }, "checkout": { "const": "unchanged" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "result": { "const": "infrastructure-blocked" } } },
      "then": { "properties": { "completion": { "enum": ["interrupted", "blocked"] } } }
    },
    {
      "if": { "properties": { "result": { "const": "invalid" } } },
      "then": { "properties": { "completion": { "enum": ["completed", "invalid"] } } }
    }
  ]
}

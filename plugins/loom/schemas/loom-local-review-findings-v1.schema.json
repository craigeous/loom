{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/craigeous/loom/schemas/loom-local-review-findings-v1.schema.json",
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "finder", "confidence", "severity", "file", "claim", "evidence", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]{2,5}-[0-9]+$" },
        "finder": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR", "NIT"] },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      },
      "dependentRequired": { "line_end": ["line"] }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "run_id", "manifest_sha256", "finder", "base_sha", "head_sha", "diff_sha256",
    "status", "findings", "provenance"
  ],
  "properties": {
    "protocol": { "const": "loom-local-review/v1" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "finder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt_version", "prompt_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "prompt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "base_sha": { "$ref": "#/$defs/sha" },
    "head_sha": { "$ref": "#/$defs/sha" },
    "diff_sha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["ran-with-findings", "ran-clean", "failed"] },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model_profile", "started_at", "finished_at", "truncated", "exit_status"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "model_profile": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "minLength": 1 },
        "finished_at": { "type": "string", "minLength": 1 },
        "truncated": { "type": "boolean" },
        "exit_status": { "type": "integer" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ran-clean" } }, "required": ["status"] },
      "then": { "properties": { "findings": { "type": "array", "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "ran-with-findings" } }, "required": ["status"] },
      "then": { "properties": { "findings": { "type": "array", "minItems": 1 } } }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/craigeous/loom/schemas/loom-eval-verdict-v1.schema.json",
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*//)[^\\u0000-\\u001f\\u007f\\\\]+$"
    },
    "text": { "type": "string", "minLength": 1 },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "title", "detail"],
      "properties": {
        "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR", "NIT"] },
        "title": { "$ref": "#/$defs/text" },
        "detail": { "$ref": "#/$defs/text" },
        "location": { "$ref": "#/$defs/text" }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "disposition", "rationale"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^[A-Z]{2,5}-[0-9]+$" },
        "disposition": { "enum": ["confirmed", "rejected", "resolved", "deferred"] },
        "rationale": { "$ref": "#/$defs/text" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "run_id",
    "manifest_sha256",
    "evaluation_type",
    "artifact",
    "head_sha",
    "verdict",
    "round",
    "title",
    "authority",
    "findings",
    "required_changes",
    "notes"
  ],
  "properties": {
    "protocol": { "const": "loom-eval-verdict/v1" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "evaluation_type": { "enum": ["plan", "research", "code"] },
    "artifact": { "$ref": "#/$defs/relpath" },
    "head_sha": { "$ref": "#/$defs/sha" },
    "base_sha": { "$ref": "#/$defs/sha" },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "round": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "authority": { "type": "array", "items": { "$ref": "#/$defs/relpath" }, "uniqueItems": true },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "required_changes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "rerun_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "result", "evidence_sha256"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "result": { "enum": ["rerun-passed", "rerun-failed"] },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "local_review": { "type": "array", "items": { "$ref": "#/$defs/adjudication" } }
  },
  "allOf": [
    {
      "if": { "properties": { "evaluation_type": { "const": "code" } }, "required": ["evaluation_type"] },
      "then": {
        "required": ["base_sha", "rerun_attempt", "local_review"],
        "properties": { "base_sha": true, "rerun_attempt": true, "local_review": true }
      },
      "else": {
        "properties": { "base_sha": false, "rerun_attempt": false, "local_review": false }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "FAIL" } }, "required": ["verdict"] },
      "then": { "properties": { "required_changes": { "type": "array", "minItems": 1 } } },
      "else": {
        "properties": {
          "required_changes": { "type": "array", "maxItems": 0 },
          "findings": {
            "type": "array",
            "items": { "type": "object", "properties": { "severity": { "enum": ["MINOR", "NIT"] } } }
          }
        }
      }
    }
  ]
}

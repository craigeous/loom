{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/craigeous/loom/schemas/loom-compatibility-matrix-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product", "version", "clientFloors", "workflows", "roles", "hookWireFixtureVersion", "rootBindings", "profiles"],
  "properties": {
    "schema": { "const": "loom-compatibility-matrix/v1" },
    "product": { "const": "loom" },
    "version": { "type": "string", "pattern": "^0\\.[23]\\.0$" },
    "clientFloors": { "type": "object", "additionalProperties": false, "required": ["claude", "codex"], "properties": { "claude": { "const": "2.1.216" }, "codex": { "const": "0.144.6" }, "antigravity": { "type": "string" } } },
    "hostFloors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["floor", "helper"],
          "properties": {
            "floor": { "const": "0.1.16" },
            "helper": { "const": "loom-host-hc" }
          }
        },
        "orca": {
          "type": "object",
          "additionalProperties": false,
          "required": ["floor", "helper"],
          "properties": {
            "floor": { "const": "1.4.250" },
            "helper": { "const": "loom-host-orca" }
          }
        }
      }
    },
    "workflows": { "type": "array", "uniqueItems": true, "items": { "enum": ["run", "research", "plan", "eval-plan", "develop", "eval-code", "status", "init"] }, "minItems": 8, "maxItems": 8 },
    "roles": { "type": "array", "uniqueItems": true, "items": { "enum": ["researcher", "planner", "plan-evaluator", "developer", "code-evaluator"] }, "minItems": 5, "maxItems": 5 },
    "hookWireFixtureVersion": { "const": "hook-wire-v1" },
    "rootBindings": { "type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": { "id": { "enum": ["claude-plugin-root/v1", "codex-skill-source/v1", "antigravity-plugin-root/v1"] }, "path": { "type": "string", "pattern": "^plugins/loom/adapters/roots/[a-z0-9-]+\\.json$" } } } },
    "profiles": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["profile", "consumers", "claude", "codex"], "properties": { "profile": { "enum": ["Economy", "Standard", "Deep review"] }, "consumers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "minItems": 1 }, "claude": { "type": "object", "additionalProperties": false, "required": ["selector"], "properties": { "selector": { "enum": ["haiku", "sonnet", "opus"] } } }, "codex": { "type": "object", "additionalProperties": false, "required": ["model", "effort"], "properties": { "model": { "type": "string", "pattern": "^(gpt-6(\\.[0-9]+)?(-[a-z0-9]+)?|gpt-5\\.6(-[a-z0-9]+)?)$" }, "effort": { "enum": ["low", "medium", "high"] } } }, "antigravity": { "type": "object", "required": ["model"], "properties": { "model": { "type": "string" } }, "additionalProperties": false } } } }
  }
}

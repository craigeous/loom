{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/craigeous/loom/schemas/loom-release-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release", "tag", "candidate", "platform", "matrix", "bashRuns", "pairs", "ownerAck"],
  "properties": {
    "schema": { "const": "loom-release-evidence/v1" },
    "release": { "const": "0.2.0" },
    "tag": { "const": "v0.2.0" },
    "candidate": { "$ref": "#/$defs/commit" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "const": "macOS 14+" },
        "arch": { "const": "arm64" }
      }
    },
    "matrix": { "const": "plugins/loom/adapters/compatibility/v0.2.0.json" },
    "bashRuns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bash32", "bash5"],
      "properties": {
        "bash32": { "$ref": "#/$defs/bashRun32" },
        "bash5": { "$ref": "#/$defs/bashRun5" }
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/pair" },
      "allOf": [
        {
          "contains": { "type": "object", "properties": { "harness": { "const": "claude-code-cli" } }, "required": ["harness"] },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "type": "object", "properties": { "harness": { "const": "codex-cli" } }, "required": ["harness"] },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.docs/evaluations/release-evidence/v0\\.2\\.0(\\.corr[0-9]+)?\\.json$",
          "maxLength": 256
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ownerAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "pairs", "evidenceSet", "candidate", "date"],
      "properties": {
        "by": { "const": "owner" },
        "pairs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["claude-code-cli", "codex-cli"] }
        },
        "evidenceSet": { "$ref": "#/$defs/sha256" },
        "candidate": { "$ref": "#/$defs/commit" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "log": { "type": "string", "maxLength": 256, "pattern": "^logs/(?!.*\\.\\.)[a-z0-9][a-z0-9._/-]*$" },
    "bashRun32": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bashVersion", "result", "log", "logSha256"],
      "properties": {
        "bashVersion": { "const": "3.2.57" },
        "result": { "const": "pass" },
        "log": { "$ref": "#/$defs/log" },
        "logSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bashRun5": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bashVersion", "result", "log", "logSha256"],
      "properties": {
        "bashVersion": { "type": "string", "pattern": "^5\\.\\d+\\.\\d+$" },
        "result": { "const": "pass" },
        "log": { "$ref": "#/$defs/log" },
        "logSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "logged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "log", "logSha256"],
      "properties": {
        "result": { "const": "pass" },
        "log": { "$ref": "#/$defs/log" },
        "logSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "log", "logSha256", "outputHash"],
      "properties": {
        "result": { "const": "pass" },
        "log": { "$ref": "#/$defs/log" },
        "logSha256": { "$ref": "#/$defs/sha256" },
        "outputHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "e4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a_roles", "b_loop", "c_gate", "d_lifecycle"],
      "properties": {
        "a_roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["researcher", "planner", "plan-evaluator", "developer", "code-evaluator"],
          "properties": {
            "researcher": { "$ref": "#/$defs/role" },
            "planner": { "$ref": "#/$defs/role" },
            "plan-evaluator": { "$ref": "#/$defs/role" },
            "developer": { "$ref": "#/$defs/role" },
            "code-evaluator": { "$ref": "#/$defs/role" }
          }
        },
        "b_loop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId", "result", "blindReview", "crossFamilyVerified", "log", "logSha256"],
          "properties": {
            "runId": { "type": "string", "minLength": 1 },
            "result": { "const": "pass" },
            "blindReview": { "const": "verified" },
            "crossFamilyVerified": { "const": true },
            "log": { "$ref": "#/$defs/log" },
            "logSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "c_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "result", "log", "logSha256"],
          "properties": {
            "command": { "const": "scripts/check" },
            "result": { "const": "pass" },
            "log": { "$ref": "#/$defs/log" },
            "logSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "d_lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["priorCandidate", "result", "log", "logSha256"],
          "properties": {
            "priorCandidate": { "$ref": "#/$defs/commit" },
            "result": { "const": "pass" },
            "log": { "$ref": "#/$defs/log" },
            "logSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "client", "floor", "e1", "e2", "e3", "e4", "authSource", "ownerStateUnchanged"],
      "properties": {
        "harness": { "enum": ["claude-code-cli", "codex-cli"] },
        "client": { "enum": ["claude", "codex"] },
        "floor": { "type": "string", "minLength": 1 },
        "e1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matrix", "entry"],
          "properties": {
            "matrix": { "const": "plugins/loom/adapters/compatibility/v0.2.0.json" },
            "entry": { "enum": ["claude", "codex"] }
          }
        },
        "e2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["binding"],
          "properties": {
            "binding": { "enum": ["claude-plugin-root/v1", "codex-skill-source/v1"] }
          }
        },
        "e3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId", "result", "log", "logSha256"],
          "properties": {
            "runId": { "type": "string", "minLength": 1 },
            "result": { "const": "pass" },
            "log": { "$ref": "#/$defs/log" },
            "logSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "e4": { "$ref": "#/$defs/e4" },
        "authSource": { "enum": ["owner-login-isolated", "setup-token-env", "api-key-env"] },
        "ownerStateUnchanged": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "harness": { "const": "claude-code-cli" } }, "required": ["harness"] },
          "then": {
            "properties": {
              "client": { "const": "claude" },
              "floor": { "const": "2.1.216" },
              "e1": { "type": "object", "properties": { "entry": { "const": "claude" } } },
              "e2": { "type": "object", "properties": { "binding": { "const": "claude-plugin-root/v1" } } }
            }
          }
        },
        {
          "if": { "properties": { "harness": { "const": "codex-cli" } }, "required": ["harness"] },
          "then": {
            "properties": {
              "client": { "const": "codex" },
              "floor": { "const": "0.144.6" },
              "e1": { "type": "object", "properties": { "entry": { "const": "codex" } } },
              "e2": { "type": "object", "properties": { "binding": { "const": "codex-skill-source/v1" } } }
            }
          }
        }
      ]
    }
  }
}
